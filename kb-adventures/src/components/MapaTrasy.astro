---
interface MapPoint {
  lat: number;
  lng: number;
  label?: string;
}

interface Props {
  points: MapPoint[];
  center?: [number, number];
  zoom?: number;
  mapId?: string;
}

const {
  points,
  center = [41.9, 16.2],
  zoom = 8,
  mapId = 'mapa-trasy',
} = Astro.props;
---

<div class="my-8 rounded-2xl overflow-hidden shadow-lg">
  <div id={mapId} class="w-full h-96 z-10"></div>
</div>

<script define:vars={{ points, center, zoom, mapId }}>
  async function initMap() {
    const L = (await import('leaflet')).default;
    // Import leaflet CSS dynamically
    if (!document.querySelector('link[href*="leaflet"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
    }

    const map = L.map(mapId).setView(center, zoom);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a>',
    }).addTo(map);

    // Custom gold icon
    const goldIcon = L.divIcon({
      className: '',
      html: `<div style="width:16px;height:16px;background:#D4A853;border:3px solid white;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.4)"></div>`,
      iconSize: [16, 16],
      iconAnchor: [8, 8],
    });

    if (points.length > 1) {
      const latlngs = points.map(p => [p.lat, p.lng]);
      L.polyline(latlngs, { color: '#D4A853', weight: 3, opacity: 0.85, dashArray: '8, 4' }).addTo(map);
    }

    points.forEach((point, i) => {
      const marker = L.marker([point.lat, point.lng], { icon: goldIcon }).addTo(map);
      if (point.label) {
        marker.bindPopup(`<strong style="font-family:serif">${point.label}</strong>`);
      }
    });
  }

  // Init when element is visible
  const el = document.getElementById(mapId);
  if (el) {
    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        initMap();
        obs.disconnect();
      }
    }, { threshold: 0.1 });
    obs.observe(el);
  }
</script>
