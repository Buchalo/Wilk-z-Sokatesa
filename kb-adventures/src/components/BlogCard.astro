---
interface Props {
  title: string;
  excerpt: string;
  coverImage: string;
  slug: string;
  date: string;
  country: string;
  tags: string[];
}

const { title, excerpt, coverImage, slug, date, country, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('pl-PL', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<a href={`/blog/${slug}`} class="blog-card group block bg-white rounded-2xl overflow-hidden shadow-md">
  <div class="relative overflow-hidden aspect-[4/3]">
    <img
      src={coverImage}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
    <span class="absolute top-4 left-4 bg-gold text-dark text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full">
      {country}
    </span>
  </div>
  <div class="p-6">
    <p class="text-xs text-gray-400 uppercase tracking-widest mb-2 font-medium">{formattedDate}</p>
    <h3 class="font-serif text-xl text-gray-900 mb-3 leading-snug group-hover:text-forest transition-colors">
      {title}
    </h3>
    <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">{excerpt}</p>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs bg-cream text-forest px-2 py-1 rounded-md font-medium">
          #{tag}
        </span>
      ))}
    </div>
  </div>
</a>
