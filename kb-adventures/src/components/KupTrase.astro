---
interface Props {
  disabled?: boolean;
  href?: string;
  filename?: string;
  price?: string;
  free?: boolean;
}

const { disabled = false, href = '#', filename = 'apulia-trasa.gpx', price = '9.99', free = false } = Astro.props;
---

<div class="my-10 rounded-2xl overflow-hidden border border-[#D4A853]/20 shadow-xl bg-gradient-to-br from-[#0a0a0a] to-[#1A4D2E]/20">
  <!-- Header -->
  <div class="bg-gradient-to-r from-[#1A4D2E] to-[#0a1a0a] px-6 pt-6 pb-4 flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        {free
          ? <span class="text-xs bg-[#D4A853] text-[#0a0a0a] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide">Za darmo</span>
          : disabled
            ? <span class="text-xs bg-white/10 text-white/50 font-semibold px-2 py-0.5 rounded-full uppercase tracking-wide">Wkrótce</span>
            : <span class="text-xs bg-[#D4A853]/20 text-[#D4A853] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide">{price} PLN</span>
        }
      </div>
      <h4 class="font-serif text-xl text-white mb-0.5">Szczegółowa trasa GPX</h4>
      <p class="text-white/50 text-sm">+ Mini przewodnik z opisami godzinowymi</p>
    </div>
    <div class="text-4xl opacity-70">🗺️</div>
  </div>

  <!-- Content -->
  <div class="px-6 py-5">
    <ul class="grid sm:grid-cols-2 gap-2 mb-5">
      {[
        '8 dni, ~950 km trasy GPX gotowe do nawigacji',
        'Godzinowe opisy każdego dnia',
        'Wskazówki gdzie jeść i nocować',
        'Alternatywne warianty trasy',
        'Format: .gpx + PDF mini ebook',
        'Działa z Garmin, Google Maps, OsmAnd',
      ].map(item => (
        <li class="flex items-center gap-2 text-sm text-white/65">
          <svg class="w-4 h-4 text-[#D4A853] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          {item}
        </li>
      ))}
    </ul>

    {disabled ? (
      <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl px-5 py-3 w-fit cursor-not-allowed opacity-60 select-none">
        <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="text-white/40 font-medium text-sm">Pobierz trasę — dostępne wkrótce</span>
      </div>
    ) : free ? (
      <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
        <a
          href={href}
          download={filename}
          class="inline-flex items-center gap-2 bg-[#D4A853] hover:bg-[#D4A853]/90 text-[#0a0a0a] font-bold px-7 py-3.5 rounded-xl transition-all shadow-lg shadow-[#D4A853]/20 hover:shadow-[#D4A853]/40 hover:-translate-y-0.5 text-sm uppercase tracking-wide"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Pobierz za darmo
        </a>
        <p class="text-white/35 text-xs">Normalnie <span class="line-through">{price} PLN</span> — teraz bezpłatnie</p>
      </div>
    ) : (
      <a
        href={href}
        class="inline-flex items-center gap-2 bg-[#D4A853] hover:bg-[#D4A853]/90 text-[#0a0a0a] font-bold px-7 py-3.5 rounded-xl transition-all shadow-lg shadow-[#D4A853]/20 text-sm uppercase tracking-wide"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Kup trasę — {price} PLN
      </a>
    )}
  </div>
</div>
