---
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  autoplay?: boolean;
  muted?: boolean;
}

const { src, poster, caption, autoplay = false, muted = true } = Astro.props;
---

<figure class="my-8 rounded-2xl overflow-hidden shadow-lg">
  <div class="relative bg-black">
    <video
      class="w-full aspect-video"
      src={src}
      poster={poster}
      controls
      preload="none"
      autoplay={autoplay}
      muted={muted}
      playsinline
    >
      Twoja przeglądarka nie obsługuje odtwarzania wideo.
    </video>
  </div>
  {caption && (
    <figcaption class="text-center text-sm text-gray-500 mt-3 italic px-4 pb-4 bg-gray-50">
      {caption}
    </figcaption>
  )}
</figure>
