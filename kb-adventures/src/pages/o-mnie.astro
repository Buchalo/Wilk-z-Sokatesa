---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="O mnie — Krzysztof Buchała" description="Przedsiębiorca. Podróżnik. Budowniczy miejsc i doświadczeń. 67 krajów.">

<style>
:root {
  --gold: #D4A853;
  --gold-dim: rgba(212,168,83,.12);
  --gold-bdr: rgba(212,168,83,.3);
  --bg:  #0a0a0a;
  --bg2: #111111;
  --bg3: #161616;
  --white: #ffffff;
  --muted: rgba(255,255,255,0.65);
  --muted2: rgba(255,255,255,0.4);
}
*, *::before, *::after { box-sizing: border-box; }
body { background: var(--bg); font-family: 'Inter', sans-serif; overflow-x: hidden; }

/* ── HERO ── */
.pm-hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  padding: 80px 6vw 0;
  gap: 48px;
  position: relative;
  overflow: hidden;
}
.pm-hero-bg {
  position: absolute; inset: 0; z-index: 0;
  background: radial-gradient(ellipse 70% 70% at 80% 50%, rgba(212,168,83,.07) 0%, transparent 65%);
}
.pm-hero-content { position: relative; z-index: 2; }
.pm-hero-eyebrow {
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 22px; font-weight: 600;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp .9s .2s forwards;
}
.pm-hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(40px, 6vw, 78px);
  font-weight: 900; line-height: 1.05;
  letter-spacing: -2px; color: #fff;
  margin-bottom: 24px;
  opacity: 0; transform: translateY(30px);
  animation: fadeUp .9s .4s forwards;
}
.pm-hero h1 em { font-style: italic; color: var(--gold); }
.pm-hero-sub {
  font-size: clamp(16px, 2vw, 19px);
  color: var(--muted); line-height: 1.65;
  margin-bottom: 40px; font-weight: 300; max-width: 480px;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp .9s .6s forwards;
}
.pm-hero-cta {
  display: flex; gap: 14px; flex-wrap: wrap;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp .9s .8s forwards;
}
.pm-btn-gold {
  background: var(--gold); color: #0a0a0a;
  padding: 14px 30px; border-radius: 30px;
  font-size: 14px; font-weight: 600; letter-spacing: .04em;
  text-decoration: none; transition: all .2s;
}
.pm-btn-gold:hover { background: #c49a40; transform: scale(1.02); }
.pm-btn-ghost {
  background: transparent; color: #fff;
  padding: 14px 30px; border-radius: 30px;
  font-size: 14px; font-weight: 400;
  border: 1px solid rgba(255,255,255,.3);
  text-decoration: none; transition: all .2s;
}
.pm-btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

.pm-hero-stats {
  display: flex; gap: 40px; margin-top: 52px;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp .9s 1s forwards;
}
.pm-stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 40px; font-weight: 700; color: #fff; line-height: 1;
}
.pm-stat-num span { color: var(--gold); }
.pm-stat-label {
  font-size: 11px; color: var(--muted2); margin-top: 4px;
  text-transform: uppercase; letter-spacing: .12em;
}

.pm-hero-scroll {
  margin-top: 48px;
  opacity: 0; animation: fadeUp .9s 1.1s forwards;
}
.pm-scroll-line {
  width: 1px; height: 48px;
  background: linear-gradient(to bottom, var(--gold), transparent);
  margin-left: 4px;
  animation: scrollPulse 2s infinite;
}

/* ── HERO PHOTO ── */
.pm-photo-wrap {
  position: relative; z-index: 2;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transform: translateX(30px) scale(0.97);
  animation: fadeRight 1s .5s forwards;
}
.pm-photo-frame {
  position: relative;
  width: min(420px, 42vw);
  aspect-ratio: 3/4;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(212,168,83,.15);
}
.pm-photo-frame img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
}
.pm-photo-frame::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 60%, rgba(10,10,10,.5) 100%);
}
.pm-photo-badge {
  position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
  background: rgba(10,10,10,.75); backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.15); border-radius: 20px;
  padding: 8px 18px; font-size: 13px; color: rgba(255,255,255,.9);
  white-space: nowrap; z-index: 3;
}
.pm-photo-badge span { color: var(--gold); font-weight: 500; }

/* ── SECTIONS ── */
.pm-section { max-width: 1100px; margin: 0 auto; padding: 100px 5vw; }
.pm-divider { width: 100%; height: 1px; background: rgba(255,255,255,.08); }
.pm-label {
  font-size: 11px; letter-spacing: .2em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 16px; font-weight: 600;
}
.pm-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(30px, 4.5vw, 50px);
  font-weight: 700; line-height: 1.1;
  letter-spacing: -1px; color: #fff; margin-bottom: 24px;
}

/* ── ABOUT ── */
.pm-about-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 60px; align-items: start; margin-top: 52px;
}
.pm-about-text p {
  font-size: 16px; line-height: 1.85;
  color: var(--muted); font-weight: 300; margin-bottom: 20px;
}
.pm-about-text p strong { color: #fff; font-weight: 500; }
.pm-about-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.pm-about-card {
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 18px; padding: 22px 18px;
  transition: border-color .3s, background .3s;
}
.pm-about-card:hover { border-color: var(--gold-bdr); background: var(--gold-dim); }
.pm-about-card-icon { font-size: 24px; margin-bottom: 10px; }
.pm-about-card-title { font-size: 14px; font-weight: 500; color: #fff; margin-bottom: 4px; }
.pm-about-card-desc { font-size: 12px; color: var(--muted2); line-height: 1.55; }

/* ── SKILLS ── */
.pm-skills-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16px; margin-top: 52px;
}
.pm-skill-card {
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 20px; padding: 28px 24px;
  transition: all .35s cubic-bezier(.25,.8,.25,1);
  opacity: 0; transform: translateY(28px);
}
.pm-skill-card.in { opacity: 1; transform: none; }
.pm-skill-card:hover {
  border-color: var(--gold-bdr);
  background: var(--gold-dim);
  transform: translateY(-4px);
}
.pm-skill-icon { font-size: 28px; margin-bottom: 14px; }
.pm-skill-name { font-size: 15px; font-weight: 500; color: #fff; margin-bottom: 6px; }
.pm-skill-desc { font-size: 13px; color: var(--muted2); line-height: 1.6; }

/* ── GLOBE ── */
.pm-globe-wrap {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 60px; align-items: center; margin-top: 52px;
}
.pm-globe-container {
  position: relative; width: 100%;
  aspect-ratio: 1; max-width: 460px; margin: 0 auto;
}
#globeCanvas { width: 100%; height: 100%; cursor: grab; border-radius: 50%; }
#globeCanvas:active { cursor: grabbing; }
.pm-globe-glow {
  position: absolute; inset: -20%;
  background: radial-gradient(circle, rgba(212,168,83,.1) 0%, transparent 65%);
  pointer-events: none; border-radius: 50%;
}
.pm-globe-count {
  font-family: 'Playfair Display', serif;
  font-size: 80px; font-weight: 900; color: #fff; line-height: 1; margin-bottom: 8px;
}
.pm-globe-count span { color: var(--gold); }
.pm-globe-sub { font-size: 17px; color: var(--muted2); font-weight: 300; margin-bottom: 32px; }
.pm-countries-list {
  display: flex; flex-wrap: wrap; gap: 8px;
  max-height: 260px; overflow-y: auto;
}
.pm-countries-list::-webkit-scrollbar { width: 3px; }
.pm-countries-list::-webkit-scrollbar-thumb { background: rgba(212,168,83,.25); border-radius: 2px; }
.pm-country-tag {
  font-size: 11px; padding: 4px 11px; border-radius: 20px;
  border: 1px solid var(--gold-bdr); color: var(--muted);
  background: var(--gold-dim);
}

/* ── CONTACT ── */
.pm-contact-box {
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 28px; padding: 64px 40px;
  margin-top: 52px; text-align: center;
  position: relative; overflow: hidden;
}
.pm-contact-box::before {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 60%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,168,83,.6), transparent);
}
.pm-contact-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700; color: #fff; margin-bottom: 16px; letter-spacing: -1px;
}
.pm-contact-sub { font-size: 16px; color: var(--muted2); font-weight: 300; margin-bottom: 36px; }
.pm-contact-btn {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--gold); color: #0a0a0a;
  padding: 15px 36px; border-radius: 30px;
  font-size: 15px; font-weight: 600;
  text-decoration: none; transition: all .2s;
}
.pm-contact-btn:hover { background: #c49a40; transform: scale(1.02); }
.pm-contact-btn svg { width: 18px; height: 18px; }

/* ── RESPONSIVE ── */
@media (max-width: 860px) {
  .pm-hero { grid-template-columns: 1fr; padding-top: 100px; }
  .pm-photo-wrap { display: none; }
  .pm-about-grid { grid-template-columns: 1fr; gap: 36px; }
  .pm-skills-grid { grid-template-columns: 1fr 1fr; }
  .pm-globe-wrap { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .pm-skills-grid { grid-template-columns: 1fr; }
  .pm-about-cards { grid-template-columns: 1fr; }
}

/* ── ANIMATIONS ── */
@keyframes fadeUp {
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeRight {
  to { opacity: 1; transform: translateX(0) scale(1); }
}
@keyframes scrollPulse {
  0%,100% { opacity: .6; } 50% { opacity: 1; }
}
.reveal {
  opacity: 0; transform: translateY(28px);
  transition: opacity .65s ease, transform .65s ease;
}
.reveal.visible { opacity: 1; transform: none; }
</style>

<!-- HERO -->
<section class="pm-hero">
  <div class="pm-hero-bg"></div>
  <div class="pm-hero-content">
    <p class="pm-hero-eyebrow">Krzysztof Buchała</p>
    <h1>Nie ma rzeczy<br><em>niemożliwych</em></h1>
    <p class="pm-hero-sub">Przedsiębiorca. Podróżnik. Budowniczy miejsc i doświadczeń.</p>
    <div class="pm-hero-cta">
      <a href="#omnie" class="pm-btn-gold">Poznaj mnie</a>
      <a href="#mapa" class="pm-btn-ghost">67 krajów →</a>
    </div>
    <div class="pm-hero-stats">
      <div>
        <div class="pm-stat-num">67<span>+</span></div>
        <div class="pm-stat-label">Krajów</div>
      </div>
      <div>
        <div class="pm-stat-num">5</div>
        <div class="pm-stat-label">Kontynentów</div>
      </div>
      <div>
        <div class="pm-stat-num">∞</div>
        <div class="pm-stat-label">Pomysłów</div>
      </div>
    </div>
    <div class="pm-hero-scroll"><div class="pm-scroll-line"></div></div>
  </div>
  <div class="pm-photo-wrap">
    <div class="pm-photo-frame">
      <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&q=80" alt="Krzysztof Buchała" />
      <div class="pm-photo-badge">KB Adventures · <span>67 krajów</span></div>
    </div>
  </div>
</section>

<div class="pm-divider"></div>

<!-- O MNIE -->
<div class="pm-section" id="omnie">
  <div class="reveal"><p class="pm-label">O mnie</p></div>
  <h2 class="pm-title reveal">Odkrywam świat.<br>Buduję miejsca.</h2>
  <div class="pm-about-grid">
    <div class="pm-about-text reveal">
      <p>Moja pasja to <strong>odkrywanie</strong> — zarówno świata, jak i nowych umiejętności. Odwiedziłem już <strong>67 krajów</strong> i nie zamierzam zwalniać tempa.</p>
      <p>Zawodowo działam w <strong>budownictwie</strong> — tworzę przestrzenie do mieszkania, miejsca które stają się domem. Obserwując mnie, może znajdziesz i <strong>swoje miejsce na ziemi</strong>.</p>
      <p>Kocham sport, aktywność i ruch — nie potrafię długo siedzieć w miejscu. Każdy szalony pomysł mnie nakręca i pcha do przodu.</p>
    </div>
    <div class="pm-about-cards reveal">
      <div class="pm-about-card">
        <div class="pm-about-card-icon">🏗️</div>
        <div class="pm-about-card-title">Budownictwo</div>
        <div class="pm-about-card-desc">Tworzę miejsca do życia z charakterem i duszą</div>
      </div>
      <div class="pm-about-card">
        <div class="pm-about-card-icon">✈️</div>
        <div class="pm-about-card-title">Podróże</div>
        <div class="pm-about-card-desc">67 krajów, 5 kontynentów i każdy rok nowe</div>
      </div>
      <div class="pm-about-card">
        <div class="pm-about-card-icon">⚡</div>
        <div class="pm-about-card-title">Energia</div>
        <div class="pm-about-card-desc">Szalone pomysły? Właśnie to mnie napędza</div>
      </div>
      <div class="pm-about-card">
        <div class="pm-about-card-icon">🏋️</div>
        <div class="pm-about-card-title">Sport</div>
        <div class="pm-about-card-desc">Aktywność to filozofia, nie hobby</div>
      </div>
    </div>
  </div>
</div>

<div class="pm-divider"></div>

<!-- SKILLS -->
<div class="pm-section" id="skills">
  <div class="reveal"><p class="pm-label">Umiejętności</p></div>
  <h2 class="pm-title reveal">Co wnoszę<br>do stołu</h2>
  <div class="pm-skills-grid">
    <div class="pm-skill-card"><div class="pm-skill-icon">🏠</div><div class="pm-skill-name">Deweloperka</div><div class="pm-skill-desc">Realizacja projektów mieszkaniowych od fundamentów po klucz w ręku</div></div>
    <div class="pm-skill-card"><div class="pm-skill-icon">📐</div><div class="pm-skill-name">Zarządzanie projektem</div><div class="pm-skill-desc">Koordynacja zespołów, harmonogramy, kontrola jakości i budżetu</div></div>
    <div class="pm-skill-card"><div class="pm-skill-icon">🤝</div><div class="pm-skill-name">Negocjacje</div><div class="pm-skill-desc">Wielokulturowe doświadczenie — 67 krajów uczy pokory i elastyczności</div></div>
    <div class="pm-skill-card"><div class="pm-skill-icon">🌍</div><div class="pm-skill-name">Perspektywa globalna</div><div class="pm-skill-desc">Rozumienie różnych rynków, kultur i modeli biznesowych z pierwszej ręki</div></div>
    <div class="pm-skill-card"><div class="pm-skill-icon">🚀</div><div class="pm-skill-name">Przedsiębiorczość</div><div class="pm-skill-desc">Zamieniam pomysły w działające biznesy — szybko, konkretnie, bez teorii</div></div>
    <div class="pm-skill-card"><div class="pm-skill-icon">🧠</div><div class="pm-skill-name">Adaptacja</div><div class="pm-skill-desc">W nowych środowiskach czuję się jak ryba w wodzie — uczę się błyskawicznie</div></div>
  </div>
</div>

<div class="pm-divider"></div>

<!-- GLOBE -->
<div class="pm-section" id="mapa">
  <div class="reveal"><p class="pm-label">Mój świat</p></div>
  <h2 class="pm-title reveal">Zaznaczone<br>na mapie</h2>
  <div class="pm-globe-wrap">
    <div class="pm-globe-container reveal">
      <div class="pm-globe-glow"></div>
      <canvas id="globeCanvas"></canvas>
    </div>
    <div class="reveal">
      <div class="pm-globe-count">67<span>+</span></div>
      <div class="pm-globe-sub">odwiedzonych krajów</div>
      <div class="pm-countries-list" id="countriesList"></div>
    </div>
  </div>
</div>

<div class="pm-divider"></div>

<!-- CONTACT -->
<div class="pm-section" id="kontakt" style="text-align:center">
  <div class="reveal"><p class="pm-label">Kontakt</p></div>
  <div class="pm-contact-box reveal">
    <h2 class="pm-contact-title">Znajdź swoje<br>miejsce na ziemi</h2>
    <p class="pm-contact-sub">Budownictwo, biznes, podróże — zawsze chętnie porozmawiam.</p>
    <a href="https://www.linkedin.com/in/krzysztof-bucha%C5%82o-38506b269" target="_blank" rel="noopener" class="pm-contact-btn">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      Napisz na LinkedIn
    </a>
  </div>
</div>

</BaseLayout>

<script>
/* ── Reveal ── */
const revObs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revObs.unobserve(e.target); } });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => revObs.observe(el));

const skillObs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: 0.12 });
document.querySelectorAll('.pm-skill-card').forEach((c, i) => {
  c.style.transitionDelay = (i * 0.08) + 's';
  skillObs.observe(c);
});

/* ── Countries list ── */
const visited = ["Botswana","Egypt","Kenya","Morocco","Namibia","South Africa","Tanzania","Zimbabwe","Armenia","Azerbaijan","Cambodia","China","Georgia","India","Israel","Jordan","Kyrgyzstan","Nepal","Oman","Palestine","Russia","Sri Lanka","Thailand","Turkey","United Arab Emirates","Vietnam","Albania","Austria","Belgium","Bosnia and Herzegovina","Bulgaria","Croatia","Cyprus","Czechia","Denmark","Estonia","France","Germany","Greece","Hungary","Iceland","Ireland","Italy","Latvia","Liechtenstein","Lithuania","Luxembourg","Malta","Montenegro","Netherlands","North Macedonia","Norway","Poland","Portugal","Romania","Serbia","Slovakia","Slovenia","Spain","Sweden","Switzerland","United Kingdom","Vatican","Mexico","Argentina","Chile"];

const list = document.getElementById('countriesList');
if (list) visited.forEach(c => { const t = document.createElement('div'); t.className = 'pm-country-tag'; t.textContent = c; list.appendChild(t); });

/* ── Globe ── */
const canvas = document.getElementById('globeCanvas') as HTMLCanvasElement | null;
if (canvas) {
  const ctx = canvas.getContext('2d')!;
  const visitedISO: Record<string,string> = {"Botswana":"BW","Egypt":"EG","Kenya":"KE","Morocco":"MA","Namibia":"NA","South Africa":"ZA","Tanzania":"TZ","Zimbabwe":"ZW","Armenia":"AM","Azerbaijan":"AZ","Cambodia":"KH","China":"CN","Georgia":"GE","India":"IN","Israel":"IL","Jordan":"JO","Kyrgyzstan":"KG","Nepal":"NP","Oman":"OM","Palestine":"PS","Russia":"RU","Sri Lanka":"LK","Thailand":"TH","Turkey":"TR","United Arab Emirates":"AE","Vietnam":"VN","Albania":"AL","Austria":"AT","Belgium":"BE","Bosnia and Herzegovina":"BA","Bulgaria":"BG","Croatia":"HR","Cyprus":"CY","Czechia":"CZ","Denmark":"DK","Estonia":"EE","France":"FR","Germany":"DE","Greece":"GR","Hungary":"HU","Iceland":"IS","Ireland":"IE","Italy":"IT","Latvia":"LV","Liechtenstein":"LI","Lithuania":"LT","Luxembourg":"LU","Malta":"MT","Montenegro":"ME","Netherlands":"NL","North Macedonia":"MK","Norway":"NO","Poland":"PL","Portugal":"PT","Romania":"RO","Serbia":"RS","Slovakia":"SK","Slovenia":"SI","Spain":"ES","Sweden":"SE","Switzerland":"CH","United Kingdom":"GB","Vatican":"VA","Mexico":"MX","Argentina":"AR","Chile":"CL"};
  const visitedSet = new Set(Object.values(visitedISO));
  let rotation = 0, targetRotation = 0, isDragging = false, lastX = 0, autoRotate = true, geoData: any = null;

  function resize() { const s = canvas!.parentElement!.clientWidth; canvas!.width = s; canvas!.height = s; }
  resize(); window.addEventListener('resize', () => { resize(); drawGlobe(); });

  function project(lon: number, lat: number, cx: number, cy: number, r: number, rot: number) {
    const lambda = (lon * Math.PI / 180) + rot, phi = lat * Math.PI / 180;
    const cosLat = Math.cos(phi);
    return { x: cx + r * cosLat * Math.sin(lambda), y: cy - r * Math.sin(phi), z: cosLat * Math.cos(lambda) };
  }

  function drawGlobe() {
    const W = canvas!.width, H = canvas!.height, cx = W / 2, cy = H / 2, r = W * 0.46;
    ctx.clearRect(0, 0, W, H);
    const g = ctx.createRadialGradient(cx - r * .2, cy - r * .2, 0, cx, cy, r);
    g.addColorStop(0, '#1a1200'); g.addColorStop(.5, '#0f0c00'); g.addColorStop(1, '#080600');
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.fillStyle = g; ctx.fill();
    ctx.strokeStyle = 'rgba(212,168,83,0.08)'; ctx.lineWidth = 0.5;
    for (let lat = -60; lat <= 60; lat += 30) { ctx.beginPath(); let f = true; for (let lon = -180; lon <= 180; lon += 2) { const p = project(lon, lat, cx, cy, r, rotation); if (p.z < 0) { f = true; continue; } f ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y); f = false; } ctx.stroke(); }
    for (let lon = -180; lon < 180; lon += 30) { ctx.beginPath(); let f = true; for (let lat2 = -90; lat2 <= 90; lat2 += 2) { const p = project(lon, lat2, cx, cy, r, rotation); if (p.z < 0) { f = true; continue; } f ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y); f = false; } ctx.stroke(); }
    if (geoData) {
      geoData.features.forEach((feature: any) => {
        const iso = feature.properties.ISO_A2 || '';
        const isV = visitedSet.has(iso);
        const geom = feature.geometry;
        const polys = geom.type === 'Polygon' ? [geom.coordinates] : geom.coordinates;
        polys.forEach((poly: any) => { poly.forEach((ring: any) => {
          ctx.beginPath(); let started = false;
          ring.forEach(([lon, lat]: [number,number]) => { const p = project(lon, lat, cx, cy, r, rotation); if (p.z < 0) { started = false; return; } started ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); started = true; });
          ctx.closePath();
          if (isV) { ctx.fillStyle = 'rgba(212,168,83,0.55)'; ctx.strokeStyle = 'rgba(212,168,83,0.9)'; }
          else { ctx.fillStyle = 'rgba(60,90,130,0.35)'; ctx.strokeStyle = 'rgba(100,140,190,0.2)'; }
          ctx.fill(); ctx.lineWidth = 0.4; ctx.stroke();
        }); });
      });
    }
    const atm = ctx.createRadialGradient(cx, cy, r * .95, cx, cy, r * 1.08);
    atm.addColorStop(0, 'rgba(212,168,83,0.07)'); atm.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.beginPath(); ctx.arc(cx, cy, r * 1.08, 0, Math.PI * 2); ctx.fillStyle = atm; ctx.fill();
    const spec = ctx.createRadialGradient(cx - r * .3, cy - r * .3, 0, cx, cy, r);
    spec.addColorStop(0, 'rgba(255,255,255,0.06)'); spec.addColorStop(.4, 'rgba(255,255,255,0)');
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.fillStyle = spec; ctx.fill();
  }

  function animate() {
    if (autoRotate) { rotation += 0.003; targetRotation = rotation; }
    else { rotation += (targetRotation - rotation) * 0.12; }
    drawGlobe(); requestAnimationFrame(animate);
  }

  canvas.addEventListener('mousedown', e => { isDragging = true; autoRotate = false; lastX = e.clientX; });
  window.addEventListener('mousemove', e => { if (!isDragging) return; targetRotation += (e.clientX - lastX) * 0.008; lastX = e.clientX; });
  window.addEventListener('mouseup', () => { isDragging = false; setTimeout(() => { autoRotate = true; }, 3000); });
  canvas.addEventListener('touchstart', e => { isDragging = true; autoRotate = false; lastX = e.touches[0].clientX; }, { passive: true });
  canvas.addEventListener('touchmove', e => { if (!isDragging) return; targetRotation += (e.touches[0].clientX - lastX) * 0.008; lastX = e.touches[0].clientX; }, { passive: true });
  canvas.addEventListener('touchend', () => { isDragging = false; setTimeout(() => { autoRotate = true; }, 3000); });
  let lastScroll = 0;
  window.addEventListener('scroll', () => { const dy = window.scrollY - lastScroll; lastScroll = window.scrollY; if (!isDragging) targetRotation += dy * 0.004; });

  fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json').then(r => r.json()).then(data => {
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js';
    s.onload = () => {
      const numToISO: Record<string,string> = {"004":"AF","008":"AL","012":"DZ","024":"AO","032":"AR","036":"AU","040":"AT","050":"BD","056":"BE","068":"BO","070":"BA","072":"BW","076":"BR","100":"BG","116":"KH","120":"CM","124":"CA","144":"LK","152":"CL","156":"CN","170":"CO","191":"HR","196":"CY","203":"CZ","208":"DK","218":"EC","818":"EG","233":"EE","231":"ET","246":"FI","250":"FR","276":"DE","300":"GR","320":"GT","340":"HN","348":"HU","356":"IN","360":"ID","364":"IR","368":"IQ","372":"IE","376":"IL","380":"IT","392":"JP","400":"JO","398":"KZ","404":"KE","417":"KG","418":"LA","422":"LB","428":"LV","440":"LT","442":"LU","504":"MA","508":"MZ","516":"NA","524":"NP","528":"NL","554":"NZ","566":"NG","578":"NO","512":"OM","586":"PK","616":"PL","620":"PT","642":"RO","643":"RU","682":"SA","710":"ZA","724":"ES","752":"SE","756":"CH","760":"SY","764":"TH","792":"TR","804":"UA","784":"AE","826":"GB","840":"US","858":"UY","862":"VE","704":"VN","716":"ZW","051":"AM","031":"AZ","268":"GE","352":"IS","498":"MD","499":"ME","807":"MK","688":"RS","703":"SK","705":"SI","275":"PS","336":"VA","470":"MT","438":"LI"};
      const countries = (window as any).topojson.feature(data, data.objects.countries);
      countries.features.forEach((f: any) => { f.properties.ISO_A2 = numToISO[String(f.id).padStart(3, '0')] || ''; });
      geoData = countries;
    };
    document.head.appendChild(s);
  }).catch(() => {});

  animate();
}
</script>
