<script>
const DAYS = [
  { lat: 40.632, lng: 17.936, zoom: 14, label: "Dzień 1 — Brindisi"           },
  { lat: 40.353, lng: 18.171, zoom: 12, label: "Dzień 2 — Lecce / Otranto"    },
  { lat: 40.730, lng: 17.407, zoom: 13, label: "Dzień 3 — Ostuni / Bari"      },
  { lat: 40.666, lng: 16.604, zoom: 12, label: "Dzień 4 — Matera"             },
  { lat: 41.277, lng: 16.415, zoom: 13, label: "Dzień 5 — Trani / Polignano"  },
  { lat: 40.783, lng: 17.236, zoom: 12, label: "Dzień 6 — Dolina Itria"       },
  { lat: 40.888, lng: 17.151, zoom: 13, label: "Dzień 7 — Grotte di Castellana"},
  { lat: 40.533, lng: 17.433, zoom: 12, label: "Dzień 8 — Grottaglie"         },
];
const OVERVIEW = { center: [40.7, 16.9], zoom: 7 };

const map = L.map('map', {
  center: OVERVIEW.center, zoom: OVERVIEW.zoom,
  zoomControl: false, attributionControl: false,
  scrollWheelZoom: false, dragging: false,
  doubleClickZoom: false, keyboard: false, tap: false, touchZoom: false,
});
L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { maxZoom: 19, subdomains: 'abcd' }).addTo(map);
L.polyline(DAYS.map(d => [d.lat, d.lng]), { color: '#E8A020', weight: 3, opacity: .55, dashArray: '7 11', lineJoin: 'round', lineCap: 'round' }).addTo(map);

const pinMarkers = [];
DAYS.forEach((d, i) => {
  const m = L.marker([d.lat, d.lng], {
    icon: L.divIcon({ className: '', html: `<div class="day-pin" id="pin-${i}"><span>${i+1}</span></div>`, iconSize: [28,28], iconAnchor: [14,28] }),
    zIndexOffset: 100,
  });
  pinMarkers.push(m);
});
function showPins() { pinMarkers.forEach(m => { if (!map.hasLayer(m)) m.addTo(map); }); }
function hidePins() { pinMarkers.forEach(m => { if (map.hasLayer(m)) map.removeLayer(m); }); }

const carMarker = L.marker(OVERVIEW.center, {
  icon: L.divIcon({ className: '', html: '<div class="car-wrap">🚗</div>', iconSize: [34,34], iconAnchor: [17,17] }),
  zIndexOffset: 500,
}).addTo(map);

let carRaf = null;
function animateCar(toLat, toLng, ms = 1400) {
  const { lat, lng } = carMarker.getLatLng();
  const from = [lat, lng], to = [toLat, toLng];
  cancelAnimationFrame(carRaf);
  const t0 = performance.now();
  (function step(t) {
    const r = Math.min((t - t0) / ms, 1);
    const e = r < .5 ? 2*r*r : -1+(4-2*r)*r;
    carMarker.setLatLng([from[0]+(to[0]-from[0])*e, from[1]+(to[1]-from[1])*e]);
    if (r < 1) carRaf = requestAnimationFrame(step);
  })(t0);
}

let currentDay = -1;
function activateDay(idx) {
  if (idx === currentDay) return;
  currentDay = idx;
  showPins();
  const d = DAYS[idx];
  const pill = document.getElementById('day-pill');
  pill.textContent = d.label; pill.style.opacity = '1';
  map.flyTo([d.lat, d.lng], d.zoom, { duration: 1.5, easeLinearity: .28 });
  animateCar(d.lat, d.lng);
  DAYS.forEach((_, i) => { const el = document.getElementById(`pin-${i}`); if (el) el.classList.toggle('active', i === idx); });
  document.querySelectorAll('.day-card').forEach((c, i) => c.classList.toggle('active', i === idx));
}
function flyOverview() {
  map.flyTo(OVERVIEW.center, OVERVIEW.zoom, { duration: 2, easeLinearity: .3 });
  document.getElementById('day-pill').style.opacity = '0';
  currentDay = -1; hidePins();
  document.querySelectorAll('.day-pin').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.day-card').forEach(el => el.classList.remove('active'));
}

const dayObs = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    const idx = parseInt(entry.target.id.replace('section-', ''));
    if (isNaN(idx)) return;
    document.getElementById(`card-${idx}`)?.classList.add('visible');
    activateDay(idx);
  });
}, { threshold: .45 });

document.querySelectorAll('.day-section[id^="section-"]').forEach(el => {
  if (el.id !== 'section-outro') dayObs.observe(el);
});

new IntersectionObserver(([e]) => {
  if (!e.isIntersecting) return;
  e.target.classList.add('visible');
  flyOverview();
}, { threshold: .35 }).observe(document.getElementById('outro-map-card'));

new IntersectionObserver(([e]) => {
  if (e.isIntersecting) flyOverview();
}, { threshold: .15 }).observe(document.getElementById('hero'));

window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 60);
  const total = document.documentElement.scrollHeight - window.innerHeight;
  document.getElementById('progress').style.width = (total > 0 ? window.scrollY / total * 100 : 0) + '%';
}, { passive: true });

document.querySelectorAll('.faq-q').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item');
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!wasOpen) item.classList.add('open');
  });
});

function handleSubmit(e) {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  btn.textContent = '✅ Zgłoszenie wysłane! Oddzwonimy wkrótce.';
  btn.style.background = '#228b22';
  btn.disabled = true;
}
</script>
