---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const HERO_VIDEO = `${base}/videos/hero-scroll.mp4`;
const HERO_POSTER = 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260612_121909_76bab362-d4d3-4a93-ad74-e3d20f623575.jpeg';

const trips = [
  {
    id: 1,
    country: 'Włochy',
    flag: '🇮🇹',
    name: 'Apulia',
    subtitle: '8 dni · ~950 km',
    desc: 'Barokowe Lecce, trulli Alberobello, Matera w skałach, Adriatyk i biała Ostuni. Pętla przez serce włoskiego południa.',
    img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_180127_c56b6731-e5c4-40ac-9338-b284bb5dd038.png',
    href: `${base}/apulia`,
    active: true,
  },
  {
    id: 2,
    country: 'Włochy / Austria',
    flag: '🏔️',
    name: 'Dolomity',
    subtitle: '8 dni · Camperem',
    desc: 'Ferraty B/C, Cristallino 3008 m, Tre Cime o świcie i donaty u Friedricha Augusta. Camperem przez Południowy Tyrol.',
    img: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80',
    href: `${base}/dolomity`,
    active: true,
  },
  {
    id: 3,
    country: 'Islandia',
    flag: '🇮🇸',
    name: 'Ring Road',
    subtitle: '10 dni · zimą',
    desc: 'Zorza polarna, gejzery, lodowce i zamarznięte wodospady. Ring Road w lutym — ciemno, zimno, niesamowicie.',
    img: 'https://images.unsplash.com/photo-1529963183134-61a90db47eaf?w=800&q=80',
    href: '#',
    active: false,
  },
  {
    id: 4,
    country: 'Maroko',
    flag: '🇲🇦',
    name: 'Atlas i Sahara',
    subtitle: '9 dni',
    desc: 'Z Marrakeszu przez przełęcze Atlasu, palm oazy i czerwone wydmy Merzouga. Południe marokańskie na głęboko.',
    img: 'https://images.unsplash.com/photo-1539020140153-e479b8c22e70?w=800&q=80',
    href: '#',
    active: false,
  },
];
---

<BaseLayout>

<div id="scroll-section" class="scroll-section-outer">
  <section id="hero" class="scroll-sticky-inner bg-[#0a0a0a]" aria-label="Hero">

    <div class="hero-giant-text" aria-hidden="true">
      <span class="hero-giant-kb">KB</span>
      <span class="hero-giant-adv">Adventures</span>
    </div>

    <div class="hero-photo-wrap">
      <video
        id="scroll-video"
        src={HERO_VIDEO}
        poster={HERO_POSTER}
        class="hero-photo-img"
        muted
        playsinline
        preload="auto"
      ></video>
      <div class="hero-photo-overlay"></div>
    </div>

    <div class="hero-content-layer" id="hero-ui">
      <div></div>
      <div></div>
      <div class="hero-stats-bar">
        <div class="hero-stat">
          <div class="hero-stat-inner">
            <span class="hero-stat-title">Przewiń</span>
            <span class="hero-stat-sub">aby odtworzyć trasę</span>
          </div>
        </div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat">
          <a href={`${base}/apulia`} class="hero-stat-inner hero-stat-gold">
            <span class="hero-stat-title">Apulia 8 dni</span>
            <span class="hero-stat-sub">Włochy · ~950 km</span>
          </a>
        </div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat">
          <a href={`${base}/blog`} class="hero-stat-inner">
            <span class="hero-stat-title">Blog</span>
            <span class="hero-stat-sub">8 wpisów z Apulii</span>
          </a>
        </div>
        <div class="hero-scroll-cue">
          <svg class="hero-scroll-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <div class="about-overlay" id="about-overlay" aria-hidden="true">
      <div class="about-overlay-inner">
        <p class="about-overlay-eyebrow">Za kierownicą i obiektywem</p>
        <h2 class="about-overlay-name">Cześć, jestem Krzysiek</h2>
        <p class="about-overlay-text">
          Kierowca, fotograf i wieczny uciekinier z biura.<br />
          Jeżdżę głównie samochodem, lubię boczne drogi<br />
          i miejsca bez gwiazdek w przewodniku.<br /><br />
          KB Adventures to moje archiwum tras — każdy wyjazd opisuję dzień po dniu,
          a do każdej trasy dołączam plik GPX i mini przewodnik.
        </p>
        <div class="about-overlay-pins">
          <span class="about-overlay-pin">🇮🇹 Apulia 2026 · 950 km</span>
          <span class="about-overlay-sep">·</span>
          <span class="about-overlay-pin about-overlay-pin--dim">🇮🇸 Islandia — wkrótce</span>
          <span class="about-overlay-sep">·</span>
          <span class="about-overlay-pin about-overlay-pin--dim">🇲🇦 Maroko — wkrótce</span>
        </div>
        <a href={`${base}/o-mnie`} class="about-overlay-cta">
          Poznaj mnie
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:1rem;height:1rem;display:inline-block;vertical-align:middle;margin-left:0.4rem">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

  </section>
</div>

<section id="wyprawy" class="trips-section">
  <div class="trips-header fade-up">
    <p class="section-eyebrow">Każda droga ma historię</p>
    <h2 class="section-title">Moje wyprawy</h2>
    <div class="section-rule"></div>
  </div>

  <div class="trips-grid">
    {trips.map((trip, i) => (
      trip.active ? (
        <a
          href={trip.href}
          class="trip-card trip-card--active fade-up"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="trip-card-img-wrap">
            <img src={trip.img} alt={trip.name} class="trip-card-img" loading="lazy" />
            <div class="trip-card-img-grad"></div>
          </div>
          <div class="trip-card-badge">Wyprawa {trip.id}</div>
          <div class="trip-card-body">
            <p class="trip-card-country">{trip.flag} {trip.country}</p>
            <h3 class="trip-card-name">{trip.name}</h3>
            <p class="trip-card-sub">{trip.subtitle}</p>
            <p class="trip-card-desc">{trip.desc}</p>
            <span class="trip-card-cta">
              Zobacz trasę
              <svg class="trip-card-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>
      ) : (
        <div
          class="trip-card trip-card--soon fade-up"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="trip-card-img-wrap">
            <img src={trip.img} alt={trip.name} class="trip-card-img" loading="lazy" />
            <div class="trip-card-img-grad"></div>
          </div>
          <div class="trip-card-badge trip-card-badge--soon">Wkrótce</div>
          <div class="trip-card-body">
            <p class="trip-card-country trip-card-country--soon">{trip.flag} {trip.country}</p>
            <h3 class="trip-card-name trip-card-name--soon">{trip.name}</h3>
            <p class="trip-card-sub trip-card-sub--soon">{trip.subtitle}</p>
            <p class="trip-card-desc trip-card-desc--soon">{trip.desc}</p>
          </div>
        </div>
      )
    ))}
  </div>
</section>

<section class="map-section">
  <div class="map-inner">
    <div class="map-text fade-up">
      <p class="section-eyebrow">Trasy i szlaki</p>
      <h2 class="section-title-light">
        Mapa<br /><em class="text-gold">moich tras</em>
      </h2>
      <p class="map-body">Każda podróż zostawia ślad. Interaktywna mapa wszystkich moich wypraw — kliknij pin, żeby przeczytać historię.</p>
      <a href={`${base}/mapa`} class="map-link fade-up">
        Otwórz mapę
        <svg class="map-link-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
    <div class="map-widget fade-in">
      <div id="mini-map" class="mini-map"></div>
    </div>
  </div>
</section>

<section class="blog-section">
  <div class="trips-header fade-up">
    <p class="section-eyebrow">Blog podróżniczy</p>
    <h2 class="section-title">Z drogi</h2>
    <div class="section-rule"></div>
  </div>

  <div class="blog-grid">
    {[
      { slug: 'puglia-droga-ktora-warto-zgubic-sie', title: 'Puglia — droga którą warto zgubić się', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_172422_6f98d093-3761-4b60-a8a0-194e8f6307aa.png', excerpt: 'Kręte drogi między oliwkowymi gajami, trulli i białe miasta Salento.' },
      { slug: 'apulia-dzien-5-trani-polignano', title: 'Dzień 5 — Trani i Polignano a Mare', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_180127_c56b6731-e5c4-40ac-9338-b284bb5dd038.png', excerpt: 'Katedra przy samym morzu i klify Polignano — dwa z najpiękniejszych widoków Apulii.' },
      { slug: 'apulia-dzien-4-matera', title: 'Dzień 4 — Matera, miasto w skałach', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_172420_e5d4d30e-efa9-4e3c-9d65-27f2ae98fff1.png', excerpt: 'Sassi di Matera — jedno z najstarszych zamieszkanych miast świata.' },
    ].map((post, i) => (
      <a
        href={`${base}/blog/${post.slug}`}
        class="blog-card-new fade-up"
        style={`transition-delay: ${i * 0.1}s`}
      >
        <div class="blog-card-img-wrap">
          <img src={post.img} alt={post.title} class="blog-card-img" loading="lazy" />
        </div>
        <div class="blog-card-body">
          <p class="blog-card-country">{post.country}</p>
          <h3 class="blog-card-title">{post.title}</h3>
          <p class="blog-card-excerpt">{post.excerpt}</p>
        </div>
      </a>
    ))}
  </div>

  <div class="blog-footer fade-up">
    <a href={`${base}/blog`} class="blog-all-link">Wszystkie wpisy</a>
  </div>
</section>

</BaseLayout>

<style>
.scroll-section-outer {
  height: 450vh;
  position: relative;
}
.scroll-sticky-inner {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: hidden;
}

.hero-giant-text {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  user-select: none;
  gap: 0;
  padding: 0 2vw;
}
.hero-giant-kb {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(100px, 22vw, 320px);
  font-weight: 700;
  color: rgba(255, 255, 255, 0.06);
  line-height: 0.85;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.hero-giant-adv {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(48px, 10vw, 140px);
  font-weight: 400;
  font-style: italic;
  color: rgba(212, 168, 83, 0.09);
  line-height: 1;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-photo-wrap {
  position: absolute;
  inset: 0;
  z-index: 2;
}
.hero-photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.5) 8%,
    rgba(0,0,0,0.92) 22%,
    rgba(0,0,0,0.97) 55%,
    rgba(0,0,0,0.85) 72%,
    rgba(0,0,0,0.4) 88%,
    transparent 100%
  );
  mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.5) 8%,
    rgba(0,0,0,0.92) 22%,
    rgba(0,0,0,0.97) 55%,
    rgba(0,0,0,0.85) 72%,
    rgba(0,0,0,0.4) 88%,
    transparent 100%
  );
}
.hero-photo-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.25) 0%,
    rgba(0,0,0,0.05) 40%,
    rgba(0,0,0,0.15) 65%,
    rgba(0,0,0,0.85) 100%
  );
}

.hero-content-layer {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 3rem;
}
.hero-topbar-label {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  font-style: italic;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.03em;
}
.hero-topbar-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}
.hero-nav-link {
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  transition: color 0.2s;
}
.hero-nav-link:hover { color: #D4A853; }
.hero-nav-cta {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  color: #0a0a0a;
  background: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 0.55rem 1.25rem;
  border-radius: 999px;
  transition: background 0.2s;
}
.hero-nav-cta:hover { background: #c49a40; }

.hero-tagline-wrap {
  text-align: center;
  padding: 0 2rem;
}
.hero-tagline {
  font-family: 'Inter', sans-serif;
  font-size: clamp(0.8rem, 1.5vw, 1rem);
  font-weight: 400;
  color: rgba(255,255,255,0.45);
  text-transform: uppercase;
  letter-spacing: 0.35em;
}

.hero-stats-bar {
  display: flex;
  align-items: stretch;
  padding: 0 3rem 2.5rem;
  gap: 0;
}
.hero-stat {
  flex: 1;
}
.hero-stat-inner {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  cursor: pointer;
  transition: opacity 0.2s;
}
.hero-stat-inner:hover { opacity: 0.75; }
.hero-stat-gold .hero-stat-title { color: #D4A853; }
.hero-stat-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(0.85rem, 1.4vw, 1.05rem);
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  line-height: 1.2;
}
.hero-stat-sub {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 400;
  color: rgba(255,255,255,0.4);
  letter-spacing: 0.04em;
}
.hero-stat-sep {
  width: 1px;
  background: rgba(255,255,255,0.12);
  margin: 0 2rem;
  align-self: stretch;
}
.hero-scroll-cue {
  display: flex;
  align-items: flex-end;
  padding-bottom: 0.15rem;
  opacity: 0.35;
  animation: bounce 2s infinite;
}
.hero-scroll-icon {
  width: 1.2rem;
  height: 1.2rem;
  color: white;
}

.about-overlay {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 3rem 4rem;
  pointer-events: none;
  opacity: 0;
  transition: none;
}
.about-overlay.visible {
  pointer-events: auto;
}
.about-overlay-inner {
  max-width: 600px;
  transform: translateY(60px);
  transition: transform 0.01s linear;
}
.about-overlay-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.65rem;
  font-weight: 700;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  margin-bottom: 0.6rem;
}
.about-overlay-name {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: rgba(255,255,255,0.95);
  line-height: 1.1;
  margin-bottom: 1rem;
}
.about-overlay-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  line-height: 1.75;
  color: rgba(255,255,255,0.6);
  margin-bottom: 1.5rem;
}
.about-overlay-pins {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.75rem;
}
.about-overlay-pin {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  letter-spacing: 0.05em;
}
.about-overlay-pin--dim { color: rgba(255,255,255,0.35); }
.about-overlay-sep { color: rgba(255,255,255,0.2); font-size: 0.7rem; }
.about-overlay-cta {
  display: inline-flex;
  align-items: center;
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  color: #0a0a0a;
  background: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  padding: 0.65rem 1.5rem;
  border-radius: 999px;
  transition: background 0.2s;
}
.about-overlay-cta:hover { background: #c49a40; }

.about-strip {
  background: #111111;
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 5rem 3rem;
}
.about-inner {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 2.5rem;
}
.about-avatar {
  flex-shrink: 0;
  width: 90px;
  height: 90px;
  border-radius: 999px;
  overflow: hidden;
  border: 2px solid rgba(212,168,83,0.35);
  box-shadow: 0 0 0 6px rgba(212,168,83,0.07);
}
.about-avatar-img { width: 100%; height: 100%; object-fit: cover; }
.about-body { flex: 1; }
.about-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  margin-bottom: 0.5rem;
}
.about-name {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 600;
  color: rgba(255,255,255,0.92);
  margin-bottom: 0.75rem;
}
.about-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.65;
  color: rgba(255,255,255,0.45);
  max-width: 560px;
  margin-bottom: 1.25rem;
}
.about-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  transition: gap 0.2s;
}
.about-link:hover { gap: 0.9rem; }
.about-link-arrow { width: 1rem; height: 1rem; }

.trips-section {
  background: #0e0e0e;
  padding: 6rem 3rem 7rem;
}
.trips-header {
  text-align: center;
  margin-bottom: 3.5rem;
}
.section-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  margin-bottom: 0.75rem;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  font-weight: 700;
  color: rgba(255,255,255,0.92);
  margin-bottom: 1rem;
}
.section-rule {
  width: 3rem;
  height: 1px;
  background: #D4A853;
  margin: 0 auto;
  opacity: 0.5;
}

.trips-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

@media (max-width: 1100px) {
  .trips-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .trips-grid { grid-template-columns: 1fr; max-width: 480px; }
}

.trip-card {
  position: relative;
  border-radius: 2px;
  overflow: hidden;
  background: #171717;
  border: 1px solid rgba(255,255,255,0.07);
  display: flex;
