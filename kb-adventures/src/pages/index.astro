<script>
  const scrollSection = document.getElementById('scroll-section') as HTMLElement | null;
  const scrollVideo = document.getElementById('scroll-video') as HTMLVideoElement | null;
  const heroUI = document.getElementById('hero-ui') as HTMLElement | null;
  const aboutOverlay = document.getElementById('about-overlay') as HTMLElement | null;
  const heroGiant = document.querySelector('.hero-giant-text') as HTMLElement | null;

  if (scrollVideo) {
    scrollVideo.load();
  }

  function onScroll() {
    if (!scrollSection || !scrollVideo) return;

    const rect = scrollSection.getBoundingClientRect();
    const totalScrollable = scrollSection.offsetHeight - window.innerHeight;
    const scrolled = Math.max(0, -rect.top);
    const progress = Math.min(1, scrolled / totalScrollable);

    if (scrollVideo.readyState >= 2 && scrollVideo.duration) {
      scrollVideo.currentTime = scrollVideo.duration * progress;
    }

    if (heroUI) {
      const uiOpacity = Math.max(0, 1 - progress / 0.25);
      heroUI.style.opacity = String(uiOpacity);
      heroUI.style.pointerEvents = uiOpacity < 0.05 ? 'none' : '';
    }

    if (heroGiant) {
      heroGiant.style.opacity = String(Math.max(0, 1 - progress / 0.35));
    }

    if (aboutOverlay) {
      const start = 0.72;
      const end = 0.95;
      const p = Math.max(0, Math.min(1, (progress - start) / (end - start)));
      aboutOverlay.style.opacity = String(p);
      (aboutOverlay.querySelector('.about-overlay-inner') as HTMLElement).style.transform =
        `translateY(${(1 - p) * 60}px)`;
      if (p > 0.05) aboutOverlay.classList.add('visible');
      else aboutOverlay.classList.remove('visible');
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  async function initMiniMap() {
    const L = (await import('leaflet')).default;
    if (!document.querySelector('link[href*="leaflet"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
    }
    const map = L.map('mini-map', { zoomControl: false, scrollWheelZoom: false, attributionControl: false }).setView([44, 12], 4);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png').addTo(map);

    const goldIcon = L.divIcon({
      className: '',
      html: `<div style="width:12px;height:12px;background:#D4A853;border:2px solid rgba(255,255,255,0.6);border-radius:50%;box-shadow:0 0 0 4px rgba(212,168,83,0.25)"></div>`,
      iconSize: [12, 12],
      iconAnchor: [6, 6],
    });

    [
      { lat: 40.7, lng: 17.1, label: 'Puglia, Włochy' },
      { lat: 46.6, lng: 12.1, label: 'Dolomity' },
      { lat: 64.9, lng: -19.0, label: 'Islandia' },
      { lat: 31.6, lng: -8.0, label: 'Maroko' },
    ].forEach(p => {
      L.marker([p.lat, p.lng], { icon: goldIcon }).addTo(map)
        .bindPopup(`<strong style="font-family:'Playfair Display',serif;font-size:13px;">${p.label}</strong>`);
    });
  }

  const miniMapEl = document.getElementById('mini-map');
  if (miniMapEl) {
    new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { initMiniMap(); }
    }, { threshold: 0.1 }).observe(miniMapEl);
  }
</script>
