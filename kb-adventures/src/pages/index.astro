---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const trips = [
  {
    id: 1,
    country: 'Włochy',
    flag: '🇮🇹',
    name: 'Apulia',
    subtitle: '8 dni · ~950 km',
    desc: 'Barokowe Lecce, trulli Alberobello, Matera w skałach, Adriatyk i biała Ostuni. Pętla przez serce włoskiego południa.',
    img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_180127_c56b6731-e5c4-40ac-9338-b284bb5dd038.png',
    href: `${base}/apulia`,
    active: true,
    tags: ['Droga', 'Morze', 'Kultura'],
  },
  {
    id: 2,
    country: 'Islandia',
    flag: '🇮🇸',
    name: 'Ring Road',
    subtitle: '10 dni · zimą',
    desc: 'Zorza polarna, gejzery, lodowce i zamarznięte wodospady. Ring Road w lutym — ciemno, zimno, niesamowicie.',
    img: 'https://images.unsplash.com/photo-1529963183134-61a90db47eaf?w=800&q=80',
    href: '#',
    active: false,
    tags: ['Natura', 'Zima', 'Droga'],
  },
  {
    id: 3,
    country: 'Maroko',
    flag: '🇲🇦',
    name: 'Atlas i Sahara',
    subtitle: '9 dni',
    desc: 'Z Marrakeszu przez przełęcze Atlasu, palm oazy i czerwone wydmy Merzouga. Południe marokańskie na głęboko.',
    img: 'https://images.unsplash.com/photo-1539020140153-e479b8c22e70?w=800&q=80',
    href: '#',
    active: false,
    tags: ['Pustynia', 'Kultura', 'Droga'],
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden bg-dark">
    <video
      class="absolute inset-0 w-full h-full object-cover opacity-45"
      src={`${base}/videos/hero.mp4`}
      autoplay muted loop playsinline preload="auto"
      transition:name="hero-video"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-br from-dark via-[#0d1a10] to-[#0a1020] opacity-65"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-dark/20"></div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto" id="hero-content">
      <p class="text-gold text-sm uppercase tracking-[0.4em] font-medium mb-4 animate-[fadeDown_0.8s_ease_0.2s_both]">
        Krzysztof Buchała
      </p>
      <h1 class="font-serif text-6xl md:text-8xl text-white font-bold leading-none mb-6 animate-[fadeUp_1s_ease_0.4s_both]">
        KB <span class="text-gold italic">Adventures</span>
      </h1>
      <p class="text-xl md:text-2xl text-white/70 font-light mb-10 animate-[fadeUp_1s_ease_0.6s_both]">
        Podróże które warto przeżyć
      </p>
      <div class="animate-[fadeUp_1s_ease_0.9s_both] flex flex-wrap gap-4 justify-center">
        <a href="#wyprawy" class="inline-block bg-gold hover:bg-[#c49a40] text-dark px-10 py-4 rounded-full font-bold tracking-wider uppercase text-sm transition-all duration-300 shadow-lg shadow-gold/30">
          Moje wyprawy
        </a>
        <a href={`${base}/blog`} class="inline-block border-2 border-white/40 text-white/90 hover:border-white hover:text-white px-10 py-4 rounded-full font-medium tracking-wider uppercase text-sm transition-all duration-300">
          Blog
        </a>
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- O MNIE -->
  <section class="py-20 px-6 bg-white">
    <div class="container mx-auto max-w-4xl">
      <div class="flex flex-col md:flex-row items-center gap-10 fade-up">
        <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-gold/40 flex-shrink-0 shadow-xl">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&q=80" alt="Krzysztof Buchała" class="w-full h-full object-cover" />
        </div>
        <div>
          <p class="text-gold text-xs uppercase tracking-[0.4em] mb-2 font-medium">Za kierownicą i obiektywem</p>
          <h2 class="font-serif text-3xl text-gray-900 mb-4">Cześć, jestem Krzysiek</h2>
          <p class="text-gray-600 leading-relaxed mb-4 max-w-xl">
            Podróżuję odkąd pamiętam. KB Adventures to nie tylko blog — to archiwum tras, emocji i widoków,
            które chcę przekazać dalej. Każda droga ma swoją historię. Do każdego wyjazdu tworzę szczegółową
            mapę GPX i mini przewodnik — żebyś mógł pojechać tą samą trasą.
          </p>
          <a href={`${base}/o-mnie`} class="inline-flex items-center gap-2 text-forest hover:gap-4 transition-all font-medium text-sm uppercase tracking-widest">
            Więcej o mnie
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MOJE WYPRAWY -->
  <section id="wyprawy" class="py-24 px-6 bg-cream">
    <div class="container mx-auto max-w-6xl">
      <div class="text-center mb-14 fade-up">
        <p class="text-gold text-xs uppercase tracking-[0.4em] mb-3 font-medium">Każda droga ma historię</p>
        <h2 class="font-serif text-5xl text-gray-900 mb-4">Moje wyprawy</h2>
        <div class="w-16 h-0.5 bg-gold mx-auto"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {trips.map((trip, i) => (
          <div class="fade-up" style={`transition-delay: ${i * 0.12}s`}>
            {trip.active ? (
              <a href={trip.href} class="group block relative rounded-2xl overflow-hidden shadow-2xl bg-dark border border-white/10 hover:-translate-y-1 transition-transform duration-300">
                <div class="aspect-[4/5] relative">
                  <img src={trip.img} alt={trip.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-75" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
                  <div class="absolute top-4 left-4">
                    <span class="text-xs bg-gold text-dark font-bold px-2.5 py-1 rounded-full uppercase tracking-wide">Wyprawa {trip.id}</span>
                  </div>
                  <div class="absolute bottom-0 left-0 right-0 p-5">
                    <p class="text-gold text-xs uppercase tracking-widest mb-1 font-medium">{trip.flag} {trip.country}</p>
                    <h3 class="font-serif text-2xl text-white font-bold mb-1">{trip.name}</h3>
                    <p class="text-white/50 text-xs mb-3">{trip.subtitle}</p>
                    <p class="text-white/65 text-sm leading-relaxed mb-4 line-clamp-3">{trip.desc}</p>
                    <div class="flex flex-wrap gap-1.5 mb-4">
                      {trip.tags.map(t => (
                        <span class="text-xs bg-white/10 text-white/60 px-2.5 py-0.5 rounded-full">{t}</span>
                      ))}
                    </div>
                    <span class="inline-flex items-center gap-2 text-gold font-semibold text-sm group-hover:gap-3 transition-all">
                      Zobacz trasę
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            ) : (
              <div class="relative rounded-2xl overflow-hidden shadow-xl bg-dark border border-white/5 opacity-60 select-none">
                <div class="aspect-[4/5] relative">
                  <img src={trip.img} alt={trip.name} class="w-full h-full object-cover opacity-40" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-black/20"></div>
                  <div class="absolute top-4 left-4">
                    <span class="text-xs bg-white/15 text-white/50 font-bold px-2.5 py-1 rounded-full uppercase tracking-wide">Wkrótce</span>
                  </div>
                  <div class="absolute bottom-0 left-0 right-0 p-5">
                    <p class="text-white/40 text-xs uppercase tracking-widest mb-1 font-medium">{trip.flag} {trip.country}</p>
                    <h3 class="font-serif text-2xl text-white/60 font-bold mb-1">{trip.name}</h3>
                    <p class="text-white/35 text-xs mb-3">{trip.subtitle}</p>
                    <p class="text-white/40 text-sm leading-relaxed line-clamp-3">{trip.desc}</p>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MAPA -->
  <section class="py-24 px-6 bg-dark">
    <div class="container mx-auto max-w-6xl">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="fade-up">
          <p class="text-gold text-xs uppercase tracking-[0.4em] mb-3 font-medium">Trasy i szlaki</p>
          <h2 class="font-serif text-5xl text-white mb-6 leading-tight">
            Mapa<br /><span class="text-gold italic">moich tras</span>
          </h2>
          <p class="text-white/60 text-lg leading-relaxed mb-8">
            Każda podróż zostawia ślad. Interaktywna mapa wszystkich moich wypraw — kliknij pin, żeby przeczytać historię.
          </p>
          <a href={`${base}/mapa`} class="inline-flex items-center gap-3 text-gold hover:gap-5 transition-all font-medium uppercase text-sm tracking-widest">
            Otwórz mapę
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="fade-in rounded-2xl overflow-hidden shadow-2xl border border-white/10">
          <div id="mini-map" class="w-full h-72"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- OSTATNIE WPISY -->
  <section class="py-24 px-6 bg-cream">
    <div class="container mx-auto max-w-6xl">
      <div class="text-center mb-14 fade-up">
        <p class="text-gold text-xs uppercase tracking-[0.4em] mb-3 font-medium">Blog podróżniczy</p>
        <h2 class="font-serif text-5xl text-gray-900 mb-4">Z drogi</h2>
        <div class="w-16 h-0.5 bg-gold mx-auto"></div>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { slug: 'puglia-droga-ktora-warto-zgubic-sie', title: 'Puglia — droga którą warto zgubić się', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_172422_6f98d093-3761-4b60-a8a0-194e8f6307aa.png', excerpt: 'Kręte drogi między oliwkowymi gajami, trulli i białe miasta Salento.' },
          { slug: 'apulia-dzien-5-trani-polignano', title: 'Dzień 5 — Trani i Polignano a Mare', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_180127_c56b6731-e5c4-40ac-9338-b284bb5dd038.png', excerpt: 'Katedra w Trani stojąca przy samym morzu i klify Polignano — dwa z najpiękniejszych widoków Apulii.' },
          { slug: 'apulia-dzien-4-matera', title: 'Dzień 4 — Matera, miasto w skałach', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_172420_e5d4d30e-efa9-4e3c-9d65-27f2ae98fff1.png', excerpt: 'Sassi di Matera — jedno z najstarszych zamieszkanych miast świata. Tu czas płynie inaczej.' },
        ].map((post, i) => (
          <a href={`${base}/blog/${post.slug}`} class="group fade-up block rounded-2xl overflow-hidden shadow-lg bg-white hover:-translate-y-1 transition-transform duration-300" style={`transition-delay: ${i * 0.12}s`}>
            <div class="aspect-[16/10] overflow-hidden">
              <img src={post.img} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div class="p-6">
              <p class="text-xs text-gold font-semibold uppercase tracking-widest mb-2">{post.country}</p>
              <h3 class="font-serif text-xl text-gray-900 font-bold mb-2 group-hover:text-forest transition-colors">{post.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{post.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-12 fade-up">
        <a href={`${base}/blog`} class="inline-block bg-dark hover:bg-forest text-white px-10 py-4 rounded-full font-medium tracking-wider uppercase text-sm transition-colors duration-300">
          Wszystkie wpisy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  async function initMiniMap() {
    const L = (await import('leaflet')).default;
    if (!document.querySelector('link[href*="leaflet"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
    }
    const map = L.map('mini-map', { zoomControl: false, scrollWheelZoom: false }).setView([40, 15], 3);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap &copy; CartoDB',
    }).addTo(map);

    const goldIcon = L.divIcon({
      className: '',
      html: `<div style="width:14px;height:14px;background:#D4A853;border:2px solid white;border-radius:50%;box-shadow:0 0 0 4px rgba(212,168,83,0.3)"></div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });

    [
      { lat: 40.7, lng: 17.1, label: 'Puglia' },
      { lat: 64.9, lng: -19.0, label: 'Islandia' },
      { lat: 31.6, lng: -8.0, label: 'Maroko' },
    ].forEach(p => {
      L.marker([p.lat, p.lng], { icon: goldIcon }).addTo(map)
        .bindPopup(`<strong style="font-family:serif">${p.label}</strong>`);
    });
  }

  const miniMapEl = document.getElementById('mini-map');
  if (miniMapEl) {
    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { initMiniMap(); obs.disconnect(); }
    }, { threshold: 0.2 });
    obs.observe(miniMapEl);
  }

  window.addEventListener('scroll', () => {
    const heroContent = document.getElementById('hero-content');
    if (heroContent && window.scrollY < window.innerHeight) {
      heroContent.style.transform = `translateY(${window.scrollY * 0.3}px)`;
      (heroContent.style as any).opacity = String(1 - window.scrollY / 600);
    }
  });
</script>
