---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const HERO_IMG = 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260612_121112_6531d020-a8ca-461f-ba1c-fa2aa45c0137.png';

const trips = [
  {
    id: 1,
    country: 'Włochy',
    flag: '🇮🇹',
    name: 'Apulia',
    subtitle: '8 dni · ~950 km',
    desc: 'Barokowe Lecce, trulli Alberobello, Matera w skałach, Adriatyk i biała Ostuni. Pętla przez serce włoskiego południa.',
    img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_180127_c56b6731-e5c4-40ac-9338-b284bb5dd038.png',
    href: `${base}/apulia`,
    active: true,
  },
  {
    id: 2,
    country: 'Islandia',
    flag: '🇮🇸',
    name: 'Ring Road',
    subtitle: '10 dni · zimą',
    desc: 'Zorza polarna, gejzery, lodowce i zamarznięte wodospady. Ring Road w lutym — ciemno, zimno, niesamowicie.',
    img: 'https://images.unsplash.com/photo-1529963183134-61a90db47eaf?w=800&q=80',
    href: '#',
    active: false,
  },
  {
    id: 3,
    country: 'Maroko',
    flag: '🇲🇦',
    name: 'Atlas i Sahara',
    subtitle: '9 dni',
    desc: 'Z Marrakeszu przez przełęcze Atlasu, palm oazy i czerwone wydmy Merzouga. Południe marokańskie na głęboko.',
    img: 'https://images.unsplash.com/photo-1539020140153-e479b8c22e70?w=800&q=80',
    href: '#',
    active: false,
  },
];
---

<BaseLayout>

<!-- ═══════════════════════════════════════════
  HERO — giant text + photo layered (WILD LIFE style)
═══════════════════════════════════════════ -->
<section id="hero" class="relative h-screen overflow-hidden bg-[#0a0a0a]" aria-label="Hero">

  <!-- Layer 1 — giant background title (z-1) -->
  <div class="hero-giant-text" aria-hidden="true">
    <span class="hero-giant-kb">KB</span>
    <span class="hero-giant-adv">Adventures</span>
  </div>

  <!-- Layer 2 — hero photo with gradient mask (z-2) -->
  <div class="hero-photo-wrap">
    <img
      src={HERO_IMG}
      alt="Włoska droga wybrzeżem Adriatyku"
      class="hero-photo-img"
      loading="eager"
      transition:name="hero-photo"
    />
    <div class="hero-photo-overlay"></div>
  </div>

  <!-- Layer 3 — content (z-3) -->
  <div class="hero-content-layer">

    <!-- Top bar -->
    <nav class="hero-topbar">
      <span class="hero-topbar-label">Krzysztof Buchała</span>
      <div class="hero-topbar-links">
        <a href={`${base}/blog`} class="hero-nav-link">Blog</a>
        <a href={`${base}/mapa`} class="hero-nav-link">Mapa</a>
        <a href={`${base}/o-mnie`} class="hero-nav-link">O mnie</a>
        <a href={`${base}/apulia`} class="hero-nav-cta">Apulia 2026</a>
      </div>
    </nav>

    <!-- Center tagline -->
    <div class="hero-tagline-wrap" id="hero-tagline">
      <p class="hero-tagline">Podróże które warto przeżyć</p>
    </div>

    <!-- Bottom stats bar -->
    <div class="hero-stats-bar" id="hero-stats">
      <div class="hero-stat">
        <a href="#wyprawy" class="hero-stat-inner">
          <span class="hero-stat-title">Moje wyprawy</span>
          <span class="hero-stat-sub">3 kraje · 27 dni</span>
        </a>
      </div>
      <div class="hero-stat-sep"></div>
      <div class="hero-stat">
        <a href={`${base}/apulia`} class="hero-stat-inner hero-stat-gold">
          <span class="hero-stat-title">Apulia 8 dni</span>
          <span class="hero-stat-sub">Włochy · ~950 km</span>
        </a>
      </div>
      <div class="hero-stat-sep"></div>
      <div class="hero-stat">
        <a href={`${base}/blog`} class="hero-stat-inner">
          <span class="hero-stat-title">Blog</span>
          <span class="hero-stat-sub">8 wpisów z Apulii</span>
        </a>
      </div>
      <div class="hero-scroll-cue">
        <svg class="hero-scroll-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </div>

</section>

<!-- ═══════════════════════════════════════════
  O MNIE — dark strip
═══════════════════════════════════════════ -->
<section class="about-strip fade-up">
  <div class="about-inner">
    <div class="about-avatar">
      <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&q=80" alt="Krzysztof Buchała" class="about-avatar-img" />
    </div>
    <div class="about-body">
      <p class="about-eyebrow">Za kierownicą i obiektywem</p>
      <h2 class="about-name">Cześć, jestem Krzysiek</h2>
      <p class="about-text">
        Podróżuję odkąd pamiętam. KB Adventures to archiwum tras, emocji i widoków —
        do każdego wyjazdu tworzę szczegółową mapę GPX i mini przewodnik, żebyś mógł pojechać tą samą drogą.
      </p>
      <a href={`${base}/o-mnie`} class="about-link">
        Więcej o mnie
        <svg class="about-link-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
  MOJE WYPRAWY
═══════════════════════════════════════════ -->
<section id="wyprawy" class="trips-section">
  <div class="trips-header fade-up">
    <p class="section-eyebrow">Każda droga ma historię</p>
    <h2 class="section-title">Moje wyprawy</h2>
    <div class="section-rule"></div>
  </div>

  <div class="trips-grid">
    {trips.map((trip, i) => (
      trip.active ? (
        <a
          href={trip.href}
          class="trip-card trip-card--active fade-up"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="trip-card-img-wrap">
            <img src={trip.img} alt={trip.name} class="trip-card-img" loading="lazy" />
            <div class="trip-card-img-grad"></div>
          </div>
          <div class="trip-card-badge">Wyprawa {trip.id}</div>
          <div class="trip-card-body">
            <p class="trip-card-country">{trip.flag} {trip.country}</p>
            <h3 class="trip-card-name">{trip.name}</h3>
            <p class="trip-card-sub">{trip.subtitle}</p>
            <p class="trip-card-desc">{trip.desc}</p>
            <span class="trip-card-cta">
              Zobacz trasę
              <svg class="trip-card-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>
      ) : (
        <div
          class="trip-card trip-card--soon fade-up"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="trip-card-img-wrap">
            <img src={trip.img} alt={trip.name} class="trip-card-img" loading="lazy" />
            <div class="trip-card-img-grad"></div>
          </div>
          <div class="trip-card-badge trip-card-badge--soon">Wkrótce</div>
          <div class="trip-card-body">
            <p class="trip-card-country trip-card-country--soon">{trip.flag} {trip.country}</p>
            <h3 class="trip-card-name trip-card-name--soon">{trip.name}</h3>
            <p class="trip-card-sub trip-card-sub--soon">{trip.subtitle}</p>
            <p class="trip-card-desc trip-card-desc--soon">{trip.desc}</p>
          </div>
        </div>
      )
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════
  MAPA
═══════════════════════════════════════════ -->
<section class="map-section">
  <div class="map-inner">
    <div class="map-text fade-up">
      <p class="section-eyebrow">Trasy i szlaki</p>
      <h2 class="section-title-light">
        Mapa<br /><em class="text-gold">moich tras</em>
      </h2>
      <p class="map-body">Każda podróż zostawia ślad. Interaktywna mapa wszystkich moich wypraw — kliknij pin, żeby przeczytać historię.</p>
      <a href={`${base}/mapa`} class="map-link fade-up">
        Otwórz mapę
        <svg class="map-link-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
    <div class="map-widget fade-in">
      <div id="mini-map" class="mini-map"></div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
  OSTATNIE WPISY
═══════════════════════════════════════════ -->
<section class="blog-section">
  <div class="trips-header fade-up">
    <p class="section-eyebrow">Blog podróżniczy</p>
    <h2 class="section-title">Z drogi</h2>
    <div class="section-rule"></div>
  </div>

  <div class="blog-grid">
    {[
      { slug: 'puglia-droga-ktora-warto-zgubic-sie', title: 'Puglia — droga którą warto zgubić się', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_172422_6f98d093-3761-4b60-a8a0-194e8f6307aa.png', excerpt: 'Kręte drogi między oliwkowymi gajami, trulli i białe miasta Salento.' },
      { slug: 'apulia-dzien-5-trani-polignano', title: 'Dzień 5 — Trani i Polignano a Mare', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_180127_c56b6731-e5c4-40ac-9338-b284bb5dd038.png', excerpt: 'Katedra przy samym morzu i klify Polignano — dwa z najpiękniejszych widoków Apulii.' },
      { slug: 'apulia-dzien-4-matera', title: 'Dzień 4 — Matera, miasto w skałach', country: '🇮🇹 Włochy', img: 'https://d8j0ntlcm91z4.cloudfront.net/user_30EqZOFYJDlJHINvYw0ajQQPBWj/hf_20260611_172420_e5d4d30e-efa9-4e3c-9d65-27f2ae98fff1.png', excerpt: 'Sassi di Matera — jedno z najstarszych zamieszkanych miast świata.' },
    ].map((post, i) => (
      <a
        href={`${base}/blog/${post.slug}`}
        class="blog-card-new fade-up"
        style={`transition-delay: ${i * 0.1}s`}
      >
        <div class="blog-card-img-wrap">
          <img src={post.img} alt={post.title} class="blog-card-img" loading="lazy" />
        </div>
        <div class="blog-card-body">
          <p class="blog-card-country">{post.country}</p>
          <h3 class="blog-card-title">{post.title}</h3>
          <p class="blog-card-excerpt">{post.excerpt}</p>
        </div>
      </a>
    ))}
  </div>

  <div class="blog-footer fade-up">
    <a href={`${base}/blog`} class="blog-all-link">Wszystkie wpisy</a>
  </div>
</section>

</BaseLayout>

<style>
/* ─────────────────── HERO ─────────────────── */
.hero-giant-text {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  user-select: none;
  gap: 0;
  padding: 0 2vw;
}
.hero-giant-kb {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(100px, 22vw, 320px);
  font-weight: 700;
  color: rgba(255, 255, 255, 0.06);
  line-height: 0.85;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.hero-giant-adv {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(48px, 10vw, 140px);
  font-weight: 400;
  font-style: italic;
  color: rgba(212, 168, 83, 0.09);
  line-height: 1;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-photo-wrap {
  position: absolute;
  inset: 0;
  z-index: 2;
}
.hero-photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.5) 8%,
    rgba(0,0,0,0.92) 22%,
    rgba(0,0,0,0.97) 55%,
    rgba(0,0,0,0.85) 72%,
    rgba(0,0,0,0.4) 88%,
    transparent 100%
  );
  mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.5) 8%,
    rgba(0,0,0,0.92) 22%,
    rgba(0,0,0,0.97) 55%,
    rgba(0,0,0,0.85) 72%,
    rgba(0,0,0,0.4) 88%,
    transparent 100%
  );
}
.hero-photo-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.25) 0%,
    rgba(0,0,0,0.05) 40%,
    rgba(0,0,0,0.15) 65%,
    rgba(0,0,0,0.85) 100%
  );
}

.hero-content-layer {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Top bar (replaces nav for hero) */
.hero-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 3rem;
}
.hero-topbar-label {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  font-style: italic;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.03em;
}
.hero-topbar-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}
.hero-nav-link {
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  transition: color 0.2s;
}
.hero-nav-link:hover { color: #D4A853; }
.hero-nav-cta {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  color: #0a0a0a;
  background: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 0.55rem 1.25rem;
  border-radius: 999px;
  transition: background 0.2s;
}
.hero-nav-cta:hover { background: #c49a40; }

/* Center tagline */
.hero-tagline-wrap {
  text-align: center;
  padding: 0 2rem;
}
.hero-tagline {
  font-family: 'Inter', sans-serif;
  font-size: clamp(0.8rem, 1.5vw, 1rem);
  font-weight: 400;
  color: rgba(255,255,255,0.45);
  text-transform: uppercase;
  letter-spacing: 0.35em;
}

/* Bottom stats bar */
.hero-stats-bar {
  display: flex;
  align-items: stretch;
  padding: 0 3rem 2.5rem;
  gap: 0;
}
.hero-stat {
  flex: 1;
}
.hero-stat-inner {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  cursor: pointer;
  transition: opacity 0.2s;
}
.hero-stat-inner:hover { opacity: 0.75; }
.hero-stat-gold .hero-stat-title { color: #D4A853; }
.hero-stat-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(0.85rem, 1.4vw, 1.05rem);
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  line-height: 1.2;
}
.hero-stat-sub {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 400;
  color: rgba(255,255,255,0.4);
  letter-spacing: 0.04em;
}
.hero-stat-sep {
  width: 1px;
  background: rgba(255,255,255,0.12);
  margin: 0 2rem;
  align-self: stretch;
}
.hero-scroll-cue {
  display: flex;
  align-items: flex-end;
  padding-bottom: 0.15rem;
  opacity: 0.35;
  animation: bounce 2s infinite;
}
.hero-scroll-icon {
  width: 1.2rem;
  height: 1.2rem;
  color: white;
}

/* ─────────────────── ABOUT ─────────────────── */
.about-strip {
  background: #111111;
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 5rem 3rem;
}
.about-inner {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 2.5rem;
}
.about-avatar {
  flex-shrink: 0;
  width: 90px;
  height: 90px;
  border-radius: 999px;
  overflow: hidden;
  border: 2px solid rgba(212,168,83,0.35);
  box-shadow: 0 0 0 6px rgba(212,168,83,0.07);
}
.about-avatar-img { width: 100%; height: 100%; object-fit: cover; }
.about-body { flex: 1; }
.about-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  margin-bottom: 0.5rem;
}
.about-name {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 600;
  color: rgba(255,255,255,0.92);
  margin-bottom: 0.75rem;
}
.about-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.65;
  color: rgba(255,255,255,0.45);
  max-width: 560px;
  margin-bottom: 1.25rem;
}
.about-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  transition: gap 0.2s;
}
.about-link:hover { gap: 0.9rem; }
.about-link-arrow { width: 1rem; height: 1rem; }

/* ─────────────────── TRIPS ─────────────────── */
.trips-section {
  background: #0e0e0e;
  padding: 6rem 3rem 7rem;
}
.trips-header {
  text-align: center;
  margin-bottom: 3.5rem;
}
.section-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  margin-bottom: 0.75rem;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  font-weight: 700;
  color: rgba(255,255,255,0.92);
  margin-bottom: 1rem;
}
.section-rule {
  width: 3rem;
  height: 1px;
  background: #D4A853;
  margin: 0 auto;
  opacity: 0.5;
}

.trips-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

@media (max-width: 900px) {
  .trips-grid { grid-template-columns: 1fr; max-width: 480px; }
}

.trip-card {
  position: relative;
  border-radius: 2px;
  overflow: hidden;
  background: #171717;
  border: 1px solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94), border-color 0.3s;
}
.trip-card--active {
  cursor: pointer;
  border-color: rgba(212,168,83,0.15);
}
.trip-card--active:hover {
  transform: translateY(-6px);
  border-color: rgba(212,168,83,0.4);
}
.trip-card--soon { opacity: 0.45; cursor: default; }

.trip-card-img-wrap {
  position: relative;
  aspect-ratio: 4/3;
  overflow: hidden;
}
.trip-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.trip-card--active:hover .trip-card-img { transform: scale(1.04); }
.trip-card-img-grad {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
}

.trip-card-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.62rem;
  font-weight: 700;
  color: #0a0a0a;
  background: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
}
.trip-card-badge--soon {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.5);
}

.trip-card-body {
  padding: 1.5rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.trip-card-country {
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 0.35rem;
}
.trip-card-country--soon { color: rgba(255,255,255,0.3); }
.trip-card-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  font-weight: 700;
  color: rgba(255,255,255,0.92);
  margin-bottom: 0.2rem;
  line-height: 1.1;
}
.trip-card-name--soon { color: rgba(255,255,255,0.4); }
.trip-card-sub {
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  color: rgba(255,255,255,0.3);
  margin-bottom: 0.85rem;
}
.trip-card-sub--soon { color: rgba(255,255,255,0.2); }
.trip-card-desc {
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.5);
  flex: 1;
  margin-bottom: 1.25rem;
}
.trip-card-desc--soon { color: rgba(255,255,255,0.25); }
.trip-card-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  transition: gap 0.2s;
}
.trip-card--active:hover .trip-card-cta { gap: 0.9rem; }
.trip-card-arrow { width: 0.9rem; height: 0.9rem; }

/* ─────────────────── MAP ─────────────────── */
.map-section {
  background: #0a0a0a;
  padding: 6rem 3rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.map-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
@media (max-width: 768px) {
  .map-inner { grid-template-columns: 1fr; gap: 2.5rem; }
}
.section-title-light {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4.5vw, 3rem);
  font-weight: 700;
  color: rgba(255,255,255,0.92);
  line-height: 1.1;
  margin-bottom: 1rem;
}
.map-body {
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.4);
  margin-bottom: 2rem;
}
.map-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  transition: gap 0.2s;
}
.map-link:hover { gap: 0.9rem; }
.map-link-arrow { width: 1rem; height: 1rem; }
.map-widget {
  border-radius: 2px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08);
}
.mini-map { width: 100%; height: 320px; }

/* ─────────────────── BLOG ─────────────────── */
.blog-section {
  background: #111111;
  padding: 6rem 3rem 7rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}
@media (max-width: 900px) { .blog-grid { grid-template-columns: 1fr; max-width: 480px; } }

.blog-card-new {
  display: flex;
  flex-direction: column;
  background: #171717;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 2px;
  overflow: hidden;
  transition: transform 0.3s ease, border-color 0.3s;
}
.blog-card-new:hover {
  transform: translateY(-5px);
  border-color: rgba(212,168,83,0.3);
}
.blog-card-img-wrap {
  aspect-ratio: 16/10;
  overflow: hidden;
}
.blog-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.blog-card-new:hover .blog-card-img { transform: scale(1.04); }
.blog-card-body { padding: 1.25rem 1.25rem 1.5rem; }
.blog-card-country {
  font-family: 'Inter', sans-serif;
  font-size: 0.65rem;
  font-weight: 700;
  color: #D4A853;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 0.4rem;
}
.blog-card-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: rgba(255,255,255,0.88);
  line-height: 1.3;
  margin-bottom: 0.5rem;
  transition: color 0.2s;
}
.blog-card-new:hover .blog-card-title { color: #D4A853; }
.blog-card-excerpt {
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.38);
}

.blog-footer {
  text-align: center;
  margin-top: 3rem;
}
.blog-all-link {
  display: inline-block;
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  color: rgba(255,255,255,0.6);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 999px;
  padding: 0.9rem 2.5rem;
  transition: border-color 0.2s, color 0.2s;
}
.blog-all-link:hover {
  border-color: #D4A853;
  color: #D4A853;
}

/* ─────────────────── ANIMATIONS ─────────────────── */
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(5px); }
}

@media (max-width: 768px) {
  .hero-topbar { padding: 1.2rem 1.5rem; }
  .hero-topbar-links { gap: 0.75rem; }
  .hero-nav-link { display: none; }
  .hero-stats-bar { padding: 0 1.5rem 2rem; gap: 0; }
  .hero-stat-sep { margin: 0 1rem; }
  .about-strip { padding: 3.5rem 1.5rem; }
  .about-inner { flex-direction: column; text-align: center; }
  .about-link { justify-content: center; }
  .trips-section, .blog-section { padding: 4rem 1.5rem 5rem; }
  .map-section { padding: 4rem 1.5rem; }
}
</style>

<script>
  /* ── Mini Map ── */
  async function initMiniMap() {
    const L = (await import('leaflet')).default;
    if (!document.querySelector('link[href*="leaflet"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
    }
    const map = L.map('mini-map', { zoomControl: false, scrollWheelZoom: false, attributionControl: false }).setView([40, 15], 3);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png').addTo(map);

    const goldIcon = L.divIcon({
      className: '',
      html: `<div style="width:12px;height:12px;background:#D4A853;border:2px solid rgba(255,255,255,0.6);border-radius:50%;box-shadow:0 0 0 4px rgba(212,168,83,0.25)"></div>`,
      iconSize: [12, 12],
      iconAnchor: [6, 6],
    });

    [
      { lat: 40.7, lng: 17.1, label: 'Puglia, Włochy' },
      { lat: 64.9, lng: -19.0, label: 'Islandia' },
      { lat: 31.6, lng: -8.0, label: 'Maroko' },
    ].forEach(p => {
      L.marker([p.lat, p.lng], { icon: goldIcon }).addTo(map)
        .bindPopup(`<strong style="font-family:'Playfair Display',serif;font-size:13px;">${p.label}</strong>`);
    });
  }

  const miniMapEl = document.getElementById('mini-map');
  if (miniMapEl) {
    new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { initMiniMap(); }
    }, { threshold: 0.1 }).observe(miniMapEl);
  }

  /* ── Parallax on giant hero text ── */
  window.addEventListener('scroll', () => {
    const text = document.querySelector('.hero-giant-text') as HTMLElement;
    const tagline = document.getElementById('hero-tagline') as HTMLElement;
    if (!text) return;
    const y = window.scrollY;
    if (y < window.innerHeight) {
      text.style.transform = `translateY(${y * 0.18}px)`;
      if (tagline) tagline.style.opacity = String(1 - y / 400);
    }
  }, { passive: true });
</script>
