---
// Dolomity Trip — interaktywna strona wyprawy ze scrollytelling mapą
import KupTrase from '../components/KupTrase.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Dolomity 8 Dni — Camperem przez ferraty | KB Adventures</title>
<meta name="description" content="8 dni camperem przez najtrudniejsze ferraty Południowego Tyrolu. Tre Cime o świcie, Cristallino 3008 m, jaskinie z I wojny i donaty u Friedricha Augusta." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;800;900&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
  --alpine:   #3A7BD5;
  --alpine-h: #2E63AF;
  --gold:     #D4A853;
  --cream:    #EEF2F7;
  --cream2:   #E3E9F0;
  --dark:     #0D1B2A;
  --dark2:    #162333;
  --mid:      #4A6380;
  --trust-bg: #0A1520;
  --card-map: rgba(10,22,36,.92);
  --card-bdr: rgba(58,123,213,.28);
  --map-text: #EEF4FF;
  --map-muted: rgba(220,235,255,.6);
  --ff-head:  'Poppins', sans-serif;
  --ff-body:  'Inter', sans-serif;
}

html { scroll-behavior: smooth; }
body { font-family: var(--ff-body); background: var(--cream); color: var(--dark); overflow-x: hidden; }
img  { display: block; max-width: 100%; }
a    { color: inherit; text-decoration: none; }

#map {
  position: fixed; inset: 0;
  width: 100vw; height: 100vh;
  z-index: 0;
}
.leaflet-tile-pane {
  filter: saturate(0.7) hue-rotate(200deg) brightness(0.82) contrast(1.1);
}
.leaflet-control-zoom,
.leaflet-control-attribution { display: none !important; }

#page { position: relative; z-index: 1; }
.solid   { background: var(--cream); }
.solid-w { background: #F5F8FC; }
.solid-d { background: var(--dark2); }
.solid-t { background: var(--trust-bg); }

#progress {
  position: fixed; top: 0; left: 0;
  height: 3px; width: 0%;
  background: linear-gradient(90deg, var(--gold), var(--alpine));
  z-index: 2000; transition: width .1s linear;
}

#nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  padding: 0 1.5rem; height: 64px;
  display: flex; align-items: center; justify-content: space-between;
  transition: background .35s, box-shadow .35s;
}
#nav.scrolled {
  background: rgba(10,22,36,.96);
  backdrop-filter: blur(12px);
  box-shadow: 0 2px 16px rgba(0,0,0,.4);
}
.nav-logo {
  font-family: var(--ff-head); font-size: 1.05rem; font-weight: 900;
  color: var(--map-text); letter-spacing: -.02em;
  display: flex; align-items: center;
}
.nav-logo span { color: var(--gold); }
.nav-right { display: flex; align-items: center; gap: 1.25rem; }
.btn { display: inline-flex; align-items: center; justify-content: center; border: none; cursor: pointer; border-radius: 8px; font-family: var(--ff-body); font-weight: 600; transition: background .2s, transform .15s; }
.btn:hover { transform: translateY(-1px); }
.btn-alpine { background: var(--alpine); color: #fff; padding: .55rem 1.25rem; font-size: .82rem; box-shadow: 0 4px 14px rgba(58,123,213,.38); }
.btn-alpine:hover { background: var(--alpine-h); }
.btn-alpine-lg { background: var(--alpine); color: #fff; padding: .85rem 2.2rem; font-size: 1rem; border-radius: 10px; box-shadow: 0 6px 20px rgba(58,123,213,.42); }
.btn-alpine-lg:hover { background: var(--alpine-h); }
.btn-outline-w { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.55); padding: .82rem 1.8rem; font-size: .95rem; border-radius: 10px; }
.btn-outline-w:hover { border-color: #fff; background: rgba(255,255,255,.1); }

#day-pill {
  position: fixed; top: 4.8rem; right: 1rem;
  background: rgba(10,22,36,.9); backdrop-filter: blur(12px);
  border: 1px solid var(--card-bdr); border-radius: 100px;
  padding: .38rem 1rem; font-size: .74rem; font-weight: 700;
  color: var(--gold); letter-spacing: .03em;
  z-index: 200; opacity: 0; transition: opacity .4s; pointer-events: none;
}

#hero {
  position: relative; height: 100vh; min-height: 580px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 6rem 1.5rem 3rem; text-align: center; background: transparent; overflow: hidden;
}
#hero-overlay {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 80% 65% at 50% 46%, rgba(5,10,18,.92) 0%, rgba(5,10,18,.72) 55%, transparent 100%),
    linear-gradient(180deg, rgba(8,16,28,.80) 0%, rgba(8,16,28,.90) 50%, rgba(8,16,28,.97) 100%);
  z-index: 0;
}
#hero > *:not(#hero-overlay) { position: relative; z-index: 1; }
.hero-badge {
  display: inline-flex; align-items: center; gap: .45rem;
  background: rgba(212,168,83,.18); border: 1px solid rgba(212,168,83,.4);
  color: var(--gold); padding: .38rem 1rem; border-radius: 100px;
  font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1.4rem;
}
.hero-title {
  font-family: var(--ff-head); font-size: clamp(2.6rem, 8vw, 4.4rem); font-weight: 900;
  color: var(--map-text); letter-spacing: -.03em; line-height: 1.0; margin-bottom: .65rem;
  text-shadow: 0 2px 16px rgba(0,0,0,.65);
}
.hero-title em { color: var(--gold); font-style: normal; display: block; }
.hero-sub { font-size: clamp(.9rem, 2.5vw, 1.05rem); color: rgba(220,235,255,.92); line-height: 1.65; max-width: 520px; margin: 0 auto 2rem; text-shadow: 0 1px 10px rgba(0,0,0,.7); }
.hero-ctas { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2rem; }
.hero-tags { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; }
.htag { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: rgba(220,235,255,.8); padding: .28rem .8rem; border-radius: 100px; font-size: .74rem; font-weight: 500; }
.hero-scroll { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: .4rem; color: var(--map-muted); font-size: .74rem; animation: bob 2.2s ease-in-out infinite; z-index: 1; }
.scroll-arrow { width: 18px; height: 18px; border-right: 2px solid var(--gold); border-bottom: 2px solid var(--gold); transform: rotate(45deg); opacity: .7; }
@keyframes bob { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(7px)} }

#trust { background: var(--trust-bg); padding: 1.1rem 1.5rem; overflow-x: auto; scrollbar-width: none; }
#trust::-webkit-scrollbar { display: none; }
.trust-inner { display: flex; gap: 0; min-width: max-content; margin: 0 auto; justify-content: center; }
.trust-item { display: flex; align-items: center; gap: .6rem; padding: 0 1.5rem; border-right: 1px solid rgba(255,255,255,.1); white-space: nowrap; }
.trust-item:last-child { border-right: none; }
.trust-icon { font-size: 1.2rem; }
.trust-text { font-size: .78rem; font-weight: 600; color: rgba(220,235,255,.85); }

.sec-head { text-align: center; padding: 4rem 1.5rem 3rem; }
.sec-tag { display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--alpine); background: rgba(58,123,213,.1); padding: .28rem .9rem; border-radius: 100px; margin-bottom: .9rem; }
.sec-title { font-family: var(--ff-head); font-size: clamp(1.7rem, 5vw, 2.5rem); font-weight: 900; color: var(--dark); letter-spacing: -.03em; line-height: 1.1; margin-bottom: .65rem; }
.sec-sub { font-size: .95rem; color: var(--mid); max-width: 540px; margin: 0 auto; line-height: 1.65; }

#trasa-section { background: transparent; padding-bottom: 0; }
.days { padding: 0 1rem 0; }
.day-section { min-height: 100vh; display: flex; align-items: center; justify-content: flex-start; padding: 3rem 0; }

.day-card {
  max-width: 400px; width: 100%;
  background: var(--card-map);
  backdrop-filter: blur(28px) saturate(1.8);
  border: 1px solid var(--card-bdr);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 16px 52px rgba(0,0,0,.55);
  opacity: 0; transform: translateX(-20px);
  transition: opacity .5s ease, transform .5s ease, border-color .4s, box-shadow .4s;
}
.day-card.visible { opacity: 1; transform: translateX(0); }
.day-card.active { border-color: rgba(212,168,83,.5); box-shadow: 0 16px 52px rgba(0,0,0,.55), 0 0 32px rgba(58,123,213,.12); }

.card-photo {
  position: relative; width: 100%; height: 180px; overflow: hidden;
}
.card-photo img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .6s ease;
}
.day-card:hover .card-photo img { transform: scale(1.04); }
.card-photo-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,.1) 0%, rgba(10,22,36,.65) 100%);
}
.card-photo-num {
  position: absolute; top: 12px; left: 14px;
  width: 38px; height: 38px;
  background: linear-gradient(135deg, var(--gold), var(--alpine));
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--ff-head); font-size: 1.05rem; font-weight: 900; color: #fff;
  box-shadow: 0 4px 14px rgba(58,123,213,.38);
}
.card-photo-title {
  position: absolute; bottom: 12px; left: 14px; right: 14px;
  font-family: var(--ff-head); font-size: .95rem; font-weight: 700;
  color: var(--map-text); line-height: 1.2;
  text-shadow: 0 1px 8px rgba(0,0,0,.8);
}

.card-body { padding: 1.2rem 1.4rem 1.4rem; }
.day-label { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--gold); margin-bottom: .3rem; }
.day-loc { display: flex; align-items: center; gap: .3rem; margin-bottom: .85rem; font-size: .72rem; color: var(--map-muted); }
.loc-dot { width: 5px; height: 5px; background: var(--alpine); border-radius: 50%; flex-shrink: 0; }
.divider-map { height: 1px; background: linear-gradient(90deg, rgba(212,168,83,.22), transparent); margin: 0 0 .85rem; }
.highlights { display: flex; flex-direction: column; gap: .52rem; margin-bottom: .85rem; }
.day-desc { font-size: .78rem; color: rgba(220,235,255,.52); line-height: 1.65; margin-bottom: .95rem; border-left: 2px solid rgba(212,168,83,.25); padding-left: .75rem; font-style: italic; }
.hl { display: flex; align-items: flex-start; gap: .58rem; }
.hl-icon { font-size: .9rem; flex-shrink: 0; margin-top: .05rem; line-height: 1.4; }
.hl-text { font-size: .8rem; color: var(--map-muted); line-height: 1.52; }
.hl-text strong { color: var(--map-text); font-weight: 600; }
.card-foot { padding-top: .85rem; border-top: 1px solid rgba(58,123,213,.1); display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
.sleep-badge { background: rgba(58,123,213,.22); border: 1px solid rgba(58,123,213,.38); color: #7ec8e3; padding: .26rem .75rem; border-radius: 100px; font-size: .68rem; font-weight: 600; }
.extra-badge { background: rgba(212,168,83,.15); border: 1px solid rgba(212,168,83,.3); color: var(--gold); padding: .26rem .75rem; border-radius: 100px; font-size: .68rem; font-weight: 600; }
.read-link {
  display: inline-flex; align-items: center; gap: .3rem;
  font-size: .72rem; font-weight: 600; color: var(--gold);
  border: 1px solid rgba(212,168,83,.35); padding: .28rem .75rem; border-radius: 100px;
  transition: background .2s, color .2s;
  white-space: nowrap;
}
.read-link:hover { background: var(--gold); color: var(--dark); }

.outro-map-card {
  background: var(--card-map); backdrop-filter: blur(28px);
  border: 1px solid var(--card-bdr); border-radius: 20px;
  padding: 2.5rem 2rem; max-width: 400px; width: 100%; text-align: center;
  box-shadow: 0 16px 52px rgba(0,0,0,.55);
  opacity: 0; transform: translateY(18px); transition: opacity .55s, transform .55s;
}
.outro-map-card.visible { opacity: 1; transform: translateY(0); }
.outro-map-card .outro-emoji { font-size: 2.5rem; margin-bottom: .8rem; }
.outro-map-card h3 { font-family: var(--ff-head); font-size: 1.6rem; font-weight: 900; color: var(--map-text); margin-bottom: .5rem; }
.outro-map-card p { font-size: .85rem; color: var(--map-muted); line-height: 1.6; }

.day-pin {
  width: 28px; height: 28px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg);
  background: var(--gold); border: 2.5px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,.45);
  display: flex; align-items: center; justify-content: center; transition: background .3s;
}
.day-pin span { transform: rotate(45deg); font-size: 9px; font-weight: 800; color: #fff; }
.day-pin.active { background: var(--alpine); animation: pinPulse 1.8s ease-in-out infinite; }
@keyframes pinPulse {
  0%,100% { box-shadow: 0 2px 8px rgba(58,123,213,.5), 0 0 0 0 rgba(58,123,213,.5); }
  55%      { box-shadow: 0 2px 8px rgba(58,123,213,.5), 0 0 0 13px rgba(58,123,213,0); }
}
.car-wrap { font-size: 1.5rem; line-height: 1; filter: drop-shadow(0 2px 5px rgba(0,0,0,.7)); pointer-events: none; }

#costs { background: #F5F8FC; padding: 0 1.5rem 5rem; }
.costs-table { max-width: 560px; margin: 0 auto; border-radius: 16px; overflow: hidden; border: 1px solid var(--cream2); }
.costs-row { display: flex; align-items: center; justify-content: space-between; padding: .85rem 1.4rem; border-bottom: 1px solid var(--cream2); font-size: .88rem; background: #fff; }
.costs-row:nth-child(even) { background: var(--cream); }
.costs-row:last-child { border-bottom: none; background: var(--dark2); color: var(--map-text); font-family: var(--ff-head); font-size: 1rem; font-weight: 900; }
.costs-row:last-child .costs-amount { color: var(--gold); font-size: 1.1rem; }
.costs-label { color: var(--mid); }
.costs-amount { font-weight: 700; color: var(--dark); white-space: nowrap; }

#faq { background: var(--cream); padding: 0 1.5rem 5rem; }
.faq-list { max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: .75rem; }
.faq-item { background: #fff; border-radius: 12px; border: 1px solid var(--cream2); overflow: hidden; }
.faq-q { width: 100%; background: none; border: none; text-align: left; padding: 1.1rem 1.3rem; font-family: var(--ff-body); font-size: .9rem; font-weight: 600; color: var(--dark); cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
.faq-q::after { content: '+'; font-size: 1.3rem; color: var(--alpine); flex-shrink: 0; transition: transform .25s; }
.faq-item.open .faq-q::after { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; padding: 0 1.3rem; font-size: .85rem; color: var(--mid); line-height: 1.7; transition: max-height .35s ease, padding .25s; }
.faq-item.open .faq-a { max-height: 300px; padding: 0 1.3rem 1.2rem; }

#plan { background: #fff; padding: 0 1.5rem 5rem; }
.plan-table-wrap { max-width: 700px; margin: 0 auto; overflow-x: auto; }
.plan-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
.plan-table th { background: var(--dark2); color: var(--map-text); padding: .75rem 1rem; text-align: left; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; white-space: nowrap; }
.plan-table td { padding: .7rem 1rem; border-bottom: 1px solid var(--cream2); color: var(--mid); vertical-align: top; }
.plan-table tr:nth-child(even) td { background: var(--cream); }
.plan-table tr:last-child td { border-bottom: none; }
.plan-day-num { font-family: var(--ff-head); font-weight: 800; color: var(--alpine); }

#footer { background: #07111C; padding: 2.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
.footer-logo { font-family: var(--ff-head); font-size: 1rem; font-weight: 900; color: var(--map-text); display: flex; align-items: center; gap: 7px; justify-content: center; }
.footer-logo span { color: var(--gold); }
.footer-links { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: center; }
.footer-links a { font-size: .78rem; color: rgba(220,235,255,.45); transition: color .2s; }
.footer-links a:hover { color: var(--map-muted); }
.footer-copy { font-size: .72rem; color: rgba(220,235,255,.3); }

@media (max-width: 680px) { .day-section { justify-content: center; } }
@media (min-width: 681px) { .day-card { margin-left: 2rem; } }
@media (min-width: 1024px) { .day-card { margin-left: 4rem; max-width: 390px; } }
</style>
</head>
<body>

<div id="progress"></div>
<div id="day-pill"></div>
<div id="map"></div>

<div id="page">

  <nav id="nav">
    <a href={`${base}/`} class="nav-logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" style="vertical-align:middle;margin-right:6px;flex-shrink:0" aria-hidden="true">
        <polygon points="14,2 26,22 2,22" fill="#D4A853" opacity=".9"/>
        <polygon points="14,7 22,22 6,22" fill="#3A7BD5" opacity=".85"/>
        <circle cx="14" cy="22" r="2.5" fill="#EEF4FF" opacity=".7"/>
      </svg>
      KB<span>&nbsp;Adventures</span>
    </a>
    <div class="nav-right">
      <a href={`${base}/blog`} style="font-size:.82rem;font-weight:600;color:rgba(220,235,255,.65);margin-right:.25rem;">Blog</a>
      <a href={`${base}/o-mnie`} style="font-size:.82rem;font-weight:600;color:rgba(220,235,255,.65);margin-right:.25rem;">O&nbsp;mnie</a>
      <a class="btn btn-alpine" href="#costs">Koszty</a>
    </div>
  </nav>

  <section id="hero">
    <div id="hero-overlay"></div>
    <div class="hero-badge">🏔️ Sierpień 2026 · Camperem</div>
    <h1 class="hero-title">DOLOMITY<em>Capo del Mondo</em></h1>
    <p class="hero-sub">8 dni camperem przez najtrudniejsze ferraty Południowego Tyrolu. Tre Cime o świcie, Cristallino 3008 m, jaskinie z I wojny i donaty u Friedricha Augusta.</p>
    <div class="hero-ctas">
      <a class="btn btn-alpine-lg" href="#costs">Zobacz koszty</a>
      <a class="btn btn-outline-w" href="#plan">Plan trasy</a>
    </div>
    <div class="hero-tags">
      <span class="htag">Ferraty B/C</span>
      <span class="htag">Trzytysięczniki</span>
      <span class="htag">Camper</span>
      <span class="htag">Sierpień</span>
      <span class="htag">Włochy/Austria</span>
    </div>
    <div class="hero-scroll"><span>Poznaj trasę</span><div class="scroll-arrow"></div></div>
  </section>

  <div id="trust" class="solid-t">
    <div class="trust-inner">
      <div class="trust-item"><span class="trust-icon">🏔️</span><span class="trust-text">8 dni w górach</span></div>
      <div class="trust-item"><span class="trust-icon">⛏️</span><span class="trust-text">~7 ferrat (B/C)</span></div>
      <div class="trust-item"><span class="trust-icon">🏔️</span><span class="trust-text">2 trzytysięczniki</span></div>
      <div class="trust-item"><span class="trust-icon">🚐</span><span class="trust-text">Camper · własny</span></div>
      <div class="trust-item"><span class="trust-icon">⛺</span><span class="trust-text">Dziko + 2 noclegi płatne</span></div>
      <div class="trust-item"><span class="trust-icon">💰</span><span class="trust-text">~5 450 zł / para</span></div>
    </div>
  </div>

  <div style="background:transparent; padding:5rem 1.5rem 1rem; text-align:center;">
    <div class="sec-tag" style="color:var(--gold);background:rgba(212,168,83,.12);">Program wyprawy</div>
    <h2 class="sec-title" style="color:var(--map-text);">Dzień po dniu</h2>
    <p class="sec-sub" style="color:var(--map-muted);">Przewiń, aby odkryć każdy przystanek. Mapa podąża za trasą.</p>
  </div>

  <section id="trasa-section">
    <div class="days">

      <div class="day-section" id="section-0">
        <div class="day-card" id="card-0">
          <div class="card-photo">
            <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400&q=80" alt="Dolomity" loading="lazy" />
            <div class="card-photo-overlay"></div>
            <div class="card-photo-num">1</div>
            <div class="card-photo-title">Dojazd + Lago di Braies</div>
          </div>
          <div class="card-body">
            <div class="day-label">15 sierpnia · Dzień 1</div>
            <div class="day-loc"><div class="loc-dot"></div>Dobbiaco → Braies → Misurina</div>
            <div class="divider-map"></div>
            <div class="highlights">
              <div class="hl"><span class="hl-icon">🌊</span><div class="hl-text"><strong>Lago di Dobbiaco</strong> — obiad z widokiem na wodę</div></div>
              <div class="hl"><span class="hl-icon">🔵</span><div class="hl-text"><strong>Lago di Braies od 16:00</strong> (bez kolejek)</div></div>
